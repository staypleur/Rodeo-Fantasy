local Rules=require("../src/shared/HuntRules")
local checks=0
local function check(value) assert(value) checks+=1 end
check(Rules.jumpHeight(0,1,10)==0)
check(math.abs(Rules.jumpHeight(0.5,1,10)-10)<0.001)
check(math.abs(Rules.jumpHeight(1,1,10))<0.001)
check(math.abs(Rules.jumpHeight(2,1,10))<0.001)
check(Rules.progress(-1,5)==0)
check(Rules.progress(2.5,5)==0.5)
check(Rules.progress(8,5)==1)
check(Rules.inRange(3,4,5))
check(not Rules.inRange(3,4.01,5))
check(not Rules.inRange(0/0,0,5))
check(not Rules.inRange(math.huge,0,5))
check(Rules.sweptBox(0,2,10,0,2,-10,0,2,0,4,4,4,0))
check(not Rules.sweptBox(5,2,10,5,2,-10,0,2,0,4,4,4,0))
check(not Rules.sweptBox(0,8,10,0,8,-10,0,2,0,4,4,4,0))
check(Rules.sweptBox(0,2,10,0,2,-10,0,2,0,4,4,4,1))
check(Rules.sweptBox(3,2,10,3,2,-10,0,2,0,4,4,4,1))
check(not Rules.sweptBox(3.1,2,10,3.1,2,-10,0,2,0,4,4,4,1))
check(Rules.sweptBox(0,2,0,0,2,0,0,2,0,4,4,4,0))
check(not Rules.sweptBox(8,2,0,8,2,0,0,2,0,4,4,4,0))
check(Rules.sweptBox(0,2,-10,0,2,10,0,2,0,4,4,4,0))
local hop,drift=Rules.buck(0,0.55,2.4)
check(math.abs(hop)<0.001 and math.abs(drift)<0.001)
local peak,direction=Rules.buck(0.275,0.55,2.4)
local nextPeak,nextDirection=Rules.buck(0.825,0.55,2.4)
check(math.abs(peak-2.4)<0.001 and math.abs(nextPeak-peak)<0.001)
check(direction>0 and nextDirection<0)
local landing=Rules.buck(0.55,0.55,2.4)
check(math.abs(landing)<0.001)
check(Rules.rideSpeed(10,nil,64,1.5)==64)
check(Rules.rideSpeed(10,10.6,64,1.5)==96)
check(Rules.rideSpeed(10.6,10.6,64,1.5)==64)
check(Rules.rideSpeed(11,10.6,64,1.5)==64)
print("PASS: "..checks.." continuous hunting checks")
