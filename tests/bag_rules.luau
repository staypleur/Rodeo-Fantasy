local Rules = require("../src/shared/BagRules")
local bag = Rules.new()
local checks = 0
local function check(value)
	assert(value)
	checks += 1
end
Rules.accrue(bag, 100, 2, 1)
check(bag.pending == 0 and #bag.monsters == 0)
Rules.grant(bag, "MeadowMouse", 100)
check(#bag.monsters == 1 and bag.monsters[1].stars == 1)
Rules.accrue(bag, 101.99, 2, 1)
check(bag.pending == 0)
Rules.accrue(bag, 102, 2, 1)
check(bag.pending == 1 and bag.balance == 0)
Rules.accrue(bag, 102, 2, 1)
check(bag.pending == 1)
Rules.grant(bag, "MeadowMouse", 103)
Rules.accrue(bag, 105, 2, 1)
check(bag.pending == 3)
check(bag.monsters[1].lastIncome == 104 and bag.monsters[2].lastIncome == 105)
-- There is no slot or equipped flag: every owned monster earns independently.
for _ = 1, 3 do Rules.grant(bag, "MeadowMouse", 105) end
check(#bag.monsters == 5)
Rules.accrue(bag, 107, 2, 1)
check(bag.pending == 8)
check(Rules.collect(bag) == 8 and bag.balance == 8 and bag.pending == 0)
check(Rules.collect(bag) == 0 and bag.balance == 8)
Rules.accrue(bag, 106, 2, 1)
check(bag.pending == 0)
Rules.accrue(bag, 110, 2, 1)
check(bag.pending == 6)
local other = Rules.new()
check(#other.monsters == 0 and other.pending == 0 and other.balance == 0)
check(Rules.collect(bag) == 6 and bag.balance == 14)
print("PASS: " .. checks .. " bag income checks")

local display=Rules.new()
Rules.grant(display,"MeadowMouse",0,2,1)
Rules.grant(display,"Weedcrow",0,2,2)
Rules.grant(display,"MeadowMouse",0,2,1)
check(Rules.place(display,1,1)) check(Rules.place(display,2,1))
check(not Rules.place(display,3,1)) check(not Rules.place(display,1,2))
check(not Rules.place(display,999,2)) check(not Rules.place(display,3,0/0))
check(not Rules.remove(display,2,2)) check(Rules.remove(display,2,1))
check(Rules.place(display,3,1))
Rules.accrue(display,4,2,1) check(display.pending==8)
Rules.accrue(display,4,2,1) check(display.pending==8)
print("PASS: mixed-species income and owned bag placement capacity/invalid requests")

local payouts=Rules.new()
Rules.grant(payouts,"MeadowMouse",0,3,1) Rules.grant(payouts,"GrassBoar",0,3,2) Rules.grant(payouts,"RockElephant",0,3,3)
local gains=Rules.accrue(payouts,3,3,1)
assert(#gains==3 and gains[1].amount==1 and gains[2].amount==2 and gains[3].amount==3)
assert(#Rules.accrue(payouts,3,3,1)==0,"same production tick must not show duplicate coins")
print("PASS: exact per-monster production events without duplicate ticks")

for stars=1,10 do
 local sample={incomeAmount=3,stars=stars}
 assert(Rules.income(sample)==3*2^(stars-1))
end
print("PASS: per-star doubling from one through ten stars")

local evolve=Rules.new()
Rules.grant(evolve,"MeadowMouse",0,3,1)
Rules.grant(evolve,"MeadowMouse",0,3,1)
Rules.grant(evolve,"MeadowMouse",0,3,1)
Rules.grant(evolve,"GrassBoar",0,3,2)
assert(Rules.place(evolve,1,2) and Rules.place(evolve,2,2))
local upgraded,affected=Rules.evolve(evolve,{1,2,3},5)
assert(upgraded and upgraded.monsterId=="MeadowMouse" and upgraded.stars==2 and upgraded.lastIncome==5)
assert(upgraded.incomeAmount==1 and upgraded.incomeSeconds==3 and #evolve.monsters==2)
assert(affected[2] and upgraded.assignedPen==nil,"evolution clears consumed ranch placements")
Rules.accrue(evolve,8,3,1)
assert(evolve.pending==6,"evolved mouse earns 2; the unconsumed boar also earns two ticks of 2")
local bad=Rules.new()
Rules.grant(bad,"MeadowMouse",0) Rules.grant(bad,"MeadowMouse",0) Rules.grant(bad,"GrassBoar",0)
assert(not Rules.evolve(bad,{1,2,3},1) and #bad.monsters==3,"mixed species must fail without consuming")
Rules.grant(bad,"MeadowMouse",0)
bad.monsters[4].stars=2
assert(not Rules.evolve(bad,{1,2,4},1) and #bad.monsters==4,"mixed stars must fail without consuming")
assert(not Rules.evolve(bad,{1,1,2},1) and #bad.monsters==4,"duplicate IDs must fail")
assert(not Rules.evolve(bad,{1,2,999},1) and #bad.monsters==4,"missing item must fail")
bad.monsters[1].stars=10 bad.monsters[2].stars=10 bad.monsters[4].stars=10
assert(not Rules.evolve(bad,{1,2,4},1) and #bad.monsters==4,"10-star monsters cannot evolve")
print("PASS: server evolution consumes three matching copies, doubles production and safely rejects invalid sets")
