local R=require("../src/shared/RecordRules")
local a=R.merge(nil,"a",10,42,1000)
assert(a.income==10 and a.distance==42)
local retry=R.merge(a,"a",10,40,1001)
assert(retry.income==10 and retry.distance==42)
local second=R.merge(retry,"b",7,60,1002)
assert(second.income==17 and second.distance==60)
local more=R.merge(second,"a",16,55,1003)
assert(more.income==23 and more.distance==60)
assert(a.income==10 and a.sessions.a.amount==10)
local after=R.merge(more,"c",4,20,1004)
assert(after.income==27 and after.distance==60)
print("PASS: persistent records, independent sessions, retries, monotonic best and immutable input")
