local R=require("../src/shared/TravelRules")
local order={"GreenStar","Zephyrus","Phyto"}
local a=R.merge(nil,"s1",{GreenStar=450.7},100)
assert(a.totalMeters==450)
local retry=R.merge(a,"s1",{GreenStar=450.7},101)
assert(retry.totalMeters==450)
local b=R.merge(retry,"s1",{GreenStar=1000},102)
assert(b.totalMeters==1000)
local c=R.merge(b,"s2",{GreenStar=9000},103)
assert(c.totalMeters==10000)
assert(R.unlocks(order,c.planetMeters).Zephyrus)
assert(not R.unlocks(order,{GreenStar=9999}).Zephyrus)
assert(not R.unlocks(order,c.planetMeters).Phyto)
local d=R.merge(c,"s2",{GreenStar=9000,Zephyrus=11000},104)
assert(d.totalMeters==21000 and R.unlocks(order,d.planetMeters).Phyto)
local concurrent=R.merge(d,"s1",{GreenStar=1200},105)
assert(concurrent.totalMeters==21200)
local lower=R.merge(concurrent,"s1",{GreenStar=100},106)
assert(lower.totalMeters==21200)
assert(not pcall(R.merge,nil,"bad",{GreenStar=0/0},100))
assert(not pcall(R.merge,nil,"bad",{GreenStar=math.huge},100))
print("TRAVEL_RULES_PASS: cumulative, retry, concurrent, thresholds, independent planets")
