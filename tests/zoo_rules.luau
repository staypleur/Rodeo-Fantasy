local Rules = require("../src/shared/ZooRules")
local session = Rules.new(4)
local checks = 0
local function check(value)
	assert(value)
	checks += 1
end
check(#session.slots == 4 and session.balance == 0)
check(not Rules.place(session, 1, 10, "Emberrat"))
Rules.grant(session)
check(not Rules.place(session, 0, 10, "Emberrat"))
check(not Rules.place(session, 1.5, 10, "Emberrat"))
check(not Rules.place(session, 0 / 0, 10, "Emberrat"))
check(not Rules.place(session, "1", 10, "Emberrat"))
check(Rules.place(session, 1, 10, "Emberrat"))
check(session.available == 0)
Rules.grant(session)
check(not Rules.place(session, 1, 10, "Emberrat"))
check(session.available == 1)
Rules.accrue(session, 11.99, 2, 1)
check(session.slots[1].pending == 0)
Rules.accrue(session, 12, 2, 1)
check(session.slots[1].pending == 1 and session.balance == 0)
Rules.accrue(session, 12, 2, 1)
check(session.slots[1].pending == 1)
check(Rules.place(session, 2, 13, "Emberrat"))
Rules.accrue(session, 17, 2, 1)
check(session.slots[1].pending == 3 and session.slots[2].pending == 2)
check(Rules.collect(session, 1) == 3 and session.balance == 3)
check(Rules.collect(session, 1) == 0 and session.balance == 3)
check(session.slots[2].pending == 2)
Rules.accrue(session, 18, 2, 1)
check(session.slots[1].pending == 1 and session.slots[2].pending == 2)
check(Rules.collect(session, 2) == 2 and session.balance == 5)
print("PASS: " .. checks .. " zoo economy checks")
