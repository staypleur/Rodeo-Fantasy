  <Item class="ServerScriptService" referent="RBX168">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX169">
      <Properties>
        <string name="Name">CaptureServer</string>
        <ProtectedString name="Source">local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local package=RS:WaitForChild("RodeoFantasy")
local Config=require(package.Config)
local Rules=require(package.HuntRules)
local BagRules=require(package.BagRules)
local World=require(script.Parent.HuntWorld)
local Course=require(package.CourseGeometry)
local remote=package.CaptureRemote
local tuning=Config.Prototype
local states,bags,limits={},{},{}
local lastSync,lastCleanup=0,0
World.init(workspace.RodeoPrototype,game:GetService("ServerStorage").RodeoMonsterTemplate,Config,Rules)
World.ensure(0)
local function now() return workspace:GetServerTimeNow() end
local function send(player,message)
 local state,bag=states[player],bags[player]
 if not bag then return end
 BagRules.accrue(bag,now(),Config.BagIncome.IncomeSeconds,Config.BagIncome.IncomeAmount)
 remote:FireClient(player,"State",{phase=state and state.phase or "Idle",started=state and state.started or now(),distance=state and state.distance or 0,monster=state and state.monster,previousMonster=state and state.previousMonster,protectedUntil=state and state.protectedUntil or 0,tamed=state and state.tamed or false,angerAt=state and state.angerAt,count=#bag.monsters,pending=bag.pending,message=message,endReason=state and state.endReason,crash=state and state.crash,sampleTime=now(),position=state and state.root.Position,origin=state and state.origin,launchY=state and state.launchY,landingSeconds=state and state.landingSeconds,steer=state and state.steer or 0,dashUntil=state and state.dashUntil})
end
local function clearRope(state)
 for _,item in ipairs(state.rope or {}) do item:Destroy() end
 state.rope=nil
end
local function attachRope(state)
 local from,to=Instance.new("Attachment"),Instance.new("Attachment")
 from.Parent,to.Parent=state.root,state.monster.PrimaryPart
 local rope=Instance.new("Beam")
 rope.Attachment0,rope.Attachment1=from,to
 rope.Width0,rope.Width1,rope.FaceCamera=0.1,0.1,true
 rope.Color,rope.Parent=ColorSequence.new(Color3.fromRGB(230,181,72)),state.root
 state.rope={from,to,rope}
end
local function freeMount(state)
 if state.monster and state.monster.Parent then
  state.monster:SetAttribute("Occupied",false)
  state.monster:SetAttribute("Running",true)
  state.monster:SetAttribute("Steering",0)
  state.monster:SetAttribute("Angry",false)
  state.monster:SetAttribute("DashUntil",nil)
  state.monster:SetAttribute("AngerWarning",false)
  state.monster:SetAttribute("AngerStarted",nil)
  local p=state.monster.PrimaryPart.Position
  state.monster.PrimaryPart.CFrame=CFrame.new(p.X,2,p.Z)
 end
 state.previousMonster,state.monster=state.monster,nil
 clearRope(state)
end
local function finish(player,reason,crashKind)
 local state=states[player]
 if not state or state.phase=="GameOver" then return end
 state.crash=crashKind~=nil
 state.endReason=crashKind
 freeMount(state)
 state.phase="GameOver"
 if state.root.Parent then
  state.root.Anchored=state.wasAnchored
  state.root.AssemblyLinearVelocity=Vector3.zero
  state.humanoid.AutoRotate,state.humanoid.PlatformStand=state.autoRotate,state.platformStand
 end
 send(player,reason)
end
local function start(player)
 local previous=states[player]
 if previous and previous.phase~="GameOver" and previous.phase~="CourseEnd" then return end
 local character=player.Character
 local root=character and character:FindFirstChild("HumanoidRootPart")
 local humanoid=character and character:FindFirstChildOfClass("Humanoid")
 if not root or not humanoid or humanoid.Health&lt;=0 then return end
 if previous then
  freeMount(previous)
  if previous.phase=="CourseEnd" and previous.root==root then
   root.Anchored=previous.wasAnchored
   humanoid.AutoRotate,humanoid.PlatformStand=previous.autoRotate,previous.platformStand
  end
 end
 World.ensure(0)
 local model=World.spawn(Vector3.new(0,2,-8))
 model:SetAttribute("Occupied",true)
 model:SetAttribute("Angry",false)
 states[player]={phase="Lassoing",started=now(),landingSeconds=tuning.IntroSeconds,monster=model,root=root,humanoid=humanoid,wasAnchored=root.Anchored,autoRotate=humanoid.AutoRotate,platformStand=humanoid.PlatformStand,steer=0,steerAt=now(),distance=0,tamed=false}
 root.Anchored,humanoid.AutoRotate,humanoid.PlatformStand=true,false,true
 root.CFrame=CFrame.new(0,2+tuning.RideHeightStuds,18)
 states[player].origin=root.CFrame
 states[player].protectedUntil=now()+tuning.IntroSeconds+tuning.LandingGraceSeconds
 attachRope(states[player])
 send(player)
end
local function launch(player,state)
 freeMount(state)
 state.phase,state.started="Airborne",now()
 state.launchY=state.root.Position.Y
 state.steer,state.dashUntil=0,nil
 state.tamed,state.angerAt=false,nil
 send(player)
end
local function lasso(player,state)
 local model=World.nearest(state.root.Position,state.previousMonster)
 if not model then return end
 local params=RaycastParams.new()
 params.FilterType=Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances={state.root.Parent,workspace.RodeoPrototype.Monsters}
 if workspace:Raycast(state.root.Position,model.PrimaryPart.Position-state.root.Position,params) then return end
 model:SetAttribute("Occupied",true)
 state.monster,state.phase,state.started=model,"Lassoing",now()
 state.protectedUntil=now()+tuning.JumpSeconds+tuning.LandingGraceSeconds
 state.origin=state.root.CFrame
 state.landingSeconds=tuning.JumpSeconds
 state.pendingDash=true
 attachRope(state)
 send(player)
end
remote.OnServerEvent:Connect(function(player,action,value)
 if type(action)~="string" or not bags[player] then return end
 if action~="Sync" and action~="Start" and action~="Jump" and action~="Steer" then return end
 local stamps=limits[player]
 if not stamps then stamps={} limits[player]=stamps end
 -- Ignore key-repeat bursts; capture transitions are always server-authoritative.
 local interval=action=="Jump" and 0.08 or action=="Steer" and 0.04 or 0.25
 if now()-(stamps[action] or -math.huge)&lt;interval then return end
 stamps[action]=now()
 if action=="Sync" then send(player) return end
 if action=="Start" then start(player) return end
 local state=states[player]
 if not state or state.phase=="GameOver" then return end
 if action=="Steer" and state.phase=="Riding" and type(value)=="number" and value==value and value&gt;=-1 and value&lt;=1 then
  state.steer,state.steerAt=value,now()
 elseif action=="Jump" and value==nil then
  if state.phase=="Riding" then launch(player,state)
  elseif state.phase=="Airborne" then lasso(player,state) end
 end
end)
RunService.Heartbeat:Connect(function(delta)
 local clock,dt=now(),math.min(delta,0.1)
 World.step(dt)
 local nearZ={0}
 for player,state in pairs(states) do
  if (state.phase=="GameOver" or state.phase=="CourseEnd") then
   if state.root.Parent then table.insert(nearZ,state.root.Position.Z) end
   continue
  end
  if not state.root.Parent or player.Character~=state.root.Parent or state.humanoid.Health&lt;=0 then finish(player,"사냥 종료") continue end
  local steer=state.phase=="Riding" and clock-state.steerAt&lt;0.5 and state.steer or 0
  local buckHeight,buckDrift=0,0
  if state.phase=="Riding" and Config.Hunt.AngerEnabled and clock-state.started&gt;=Config.Hunt.AngerSeconds then
   state.angerAt=state.angerAt or clock
   local elapsed=clock-state.angerAt-tuning.AngerWarningSeconds
   if elapsed&gt;=0 then
    buckHeight,buckDrift=Rules.buck(elapsed,tuning.BuckCycleSeconds,tuning.BuckHeightStuds)
    steer*=tuning.AngrySteerMultiplier
   end
  end
  local old=state.phase=="Riding" and state.monster and state.monster.PrimaryPart.Position or state.root.Position
  local speed=state.phase=="Airborne" and tuning.AirStudsPerSecond or Rules.rideSpeed(clock,state.phase=="Riding" and state.dashUntil,tuning.ForwardStudsPerSecond,tuning.SwitchDashMultiplier)
  local position=Vector3.new(math.clamp(old.X+(steer*tuning.SidewaysStudsPerSecond+buckDrift*tuning.BuckSidewaysStudsPerSecond)*dt,-tuning.RoadHalfWidth,tuning.RoadHalfWidth),old.Y,old.Z-speed*dt)
  if state.distance+speed*dt*tuning.MetersPerStud&gt;=Course.LengthMeters then
   state.distance=Course.LengthMeters
   state.phase="CourseEnd" state.dashUntil=nil
   if state.monster then state.monster:SetAttribute("Running",false) state.monster:SetAttribute("DashUntil",nil) state.monster:SetAttribute("Angry",false) state.monster:SetAttribute("AngerWarning",false) end
   if state.monster then
    local p=state.monster.PrimaryPart.Position
    state.monster.PrimaryPart.CFrame=CFrame.new(p.X,2,p.Z)
    state.root.CFrame=state.monster:GetPivot()*CFrame.new(0,tuning.RideHeightStuds,tuning.RideForwardStuds)
   end
   clearRope(state)
   send(player,"다음 지역 준비 중")
   continue
  end
  state.distance+=speed*dt*tuning.MetersPerStud
  World.ensure(position.Z)
  table.insert(nearZ,position.Z)
  if state.phase=="Airborne" then
   position=Vector3.new(position.X,state.launchY+Rules.jumpHeight(clock-state.started,tuning.FlightSeconds,tuning.JumpArcStuds),position.Z)
   state.root.CFrame=CFrame.new(position)
   if clock&gt;=(state.protectedUntil or 0) and World.hit(old,position) then finish(player,"장애물에 부딪혔어요.","Obstacle") continue end
   if state.phase=="Airborne" and clock-state.started&gt;=tuning.FlightSeconds then finish(player,"다음 몬스터를 잡지 못했어요.") end
  elseif state.phase=="Lassoing" then
   if not state.monster or not state.monster.Parent then finish(player,"몬스터를 놓쳤어요.") continue end
   local p=state.monster.PrimaryPart.Position
   state.monster.PrimaryPart.CFrame=CFrame.new(p.X,2,p.Z-tuning.ForwardStudsPerSecond*dt)
   local saddle=state.monster:GetPivot()*CFrame.new(0,tuning.RideHeightStuds,tuning.RideForwardStuds)
   local landingSeconds=state.landingSeconds or tuning.JumpSeconds
   local landingProgress=math.clamp((clock-state.started)/landingSeconds,0,1)
   state.root.CFrame=state.origin:Lerp(saddle,landingProgress)*CFrame.new(0,math.sin(math.pi*landingProgress)*tuning.JumpArcStuds*0.5,0)
   if clock&gt;=(state.protectedUntil or 0) and World.hit(p,state.monster.PrimaryPart.Position) then finish(player,"장애물에 부딪혔어요.","Obstacle") continue end
   if clock-state.started&gt;=landingSeconds then
    clearRope(state)
    state.phase,state.started,state.tamed="Riding",clock,state.monster:GetAttribute("Tamed_"..player.UserId)==true
    state.dashUntil=state.pendingDash and clock+tuning.SwitchDashSeconds or nil
    state.pendingDash=nil
    state.monster:SetAttribute("DashUntil",state.dashUntil)
    state.protectedUntil=clock+tuning.LandingGraceSeconds
    state.monster:SetAttribute("RunStarted",clock)
    state.monster:SetAttribute("Angry",false)
    state.monster:SetAttribute("AngerWarning",false)
    state.monster:SetAttribute("AngerStarted",nil)
    send(player)
    -- Space presses during landing are not queued as a new jump.
   end
  elseif state.phase=="Riding" then
   if not state.monster or not state.monster.Parent then finish(player,"몬스터를 놓쳤어요.") continue end
   position=Vector3.new(position.X,2+buckHeight,position.Z)
   local before=state.monster.PrimaryPart.Position
   state.monster.PrimaryPart.CFrame=CFrame.new(position)
   state.monster:SetAttribute("Steering",steer)
   state.root.CFrame=state.monster:GetPivot()*CFrame.new(0,tuning.RideHeightStuds,tuning.RideForwardStuds)
   local contact=World.mountedHit(before,position,state.monster)
   if contact then finish(player,contact=="Wall" and "벽에 부딪혔어요." or "다른 몬스터에 부딪혔어요.",contact) continue end
   if clock&gt;=(state.protectedUntil or 0) and World.hit(before,position) then finish(player,"장애물에 부딪혔어요.","Obstacle") continue end
   if not state.tamed and clock-state.started&gt;=Config.Hunt.TameSeconds then
    state.tamed=true BagRules.grant(bags[player],Config.Monster.Id,clock) send(player,Config.Monster.Name.." 길들이기 성공! 가방에 추가됐어요.")
    state.monster:SetAttribute("Tamed_"..player.UserId,true)
   end
   if Config.Hunt.AngerEnabled and clock-state.started&gt;=Config.Hunt.AngerSeconds then
    state.angerAt=state.angerAt or clock
    state.monster:SetAttribute("AngerWarning",true)
    state.monster:SetAttribute("AngerStarted",state.angerAt+tuning.AngerWarningSeconds)
    state.monster:SetAttribute("Angry",clock-state.angerAt&gt;=tuning.AngerWarningSeconds)
    -- Anger persists until the rider chooses to jump or a real collision ends the run.
   end
  end
 end
 if clock-lastSync&gt;=0.25 then lastSync=clock for _,player in ipairs(Players:GetPlayers()) do send(player) end end
 if clock-lastCleanup&gt;=3 then lastCleanup=clock World.cleanup(nearZ) end
end)
local function added(player)
 bags[player]=BagRules.new()
 player.CharacterRemoving:Connect(function() finish(player,"사냥 종료") states[player]=nil end)
end
Players.PlayerAdded:Connect(added)
Players.PlayerRemoving:Connect(function(player) finish(player,"사냥 종료") states[player],bags[player],limits[player]=nil,nil,nil end)
for _,player in ipairs(Players:GetPlayers()) do added(player) end
</ProtectedString>
        <bool name="Disabled">false</bool>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX170">
      <Properties>
        <string name="Name">HuntWorld</string>
        <ProtectedString name="Source">local World = {}
local chunks, animals, previousPositions = {}, {}, {}
local root, monsters, obstacles, template, tuning
local Rules
local monsterId
local Motion=require(game:GetService("ReplicatedStorage"):WaitForChild("RodeoFantasy"):WaitForChild("HerdMotion"))
local Course=require(game:GetService("ReplicatedStorage").RodeoFantasy.CourseGeometry)
local spawnSerial=0

local function part(parent, name, position, size, color)
	local item = Instance.new("Part")
	item.Name, item.Anchored = name, true
	item.Size, item.Position, item.Color = size, position, color
	item.Material = Enum.Material.Sand
	item.Parent = parent
	return item
end

local function decoration(parent,name,position,size,color)
 local node=part(parent,name,position,size,color)
 node.Material=Enum.Material.SmoothPlastic
 node.CanCollide,node.CanTouch,node.CanQuery=false,false,false
 node.TopSurface,node.BottomSurface=Enum.SurfaceType.Smooth,Enum.SurfaceType.Smooth
 return node
end

local function dressObstacle(rock,style,scale)
 rock.Transparency=1 rock:SetAttribute("Style",style) rock:SetAttribute("Scale",scale)
 local base=Vector3.new(rock.Position.X,0,rock.Position.Z)
 local function detail(name,pos,size,color)
  return decoration(rock,name,base+pos*scale,size*scale,color)
 end
 if style=="Tree" then
  detail("TreeTrunk",Vector3.new(0,2.2,0),Vector3.new(1.25,4.4,1.25),Color3.fromRGB(146,101,70))
  detail("TreeRoots",Vector3.new(0,0.25,0),Vector3.new(2.4,0.5,2.4),Color3.fromRGB(165,117,77))
  detail("LeafCrown",Vector3.new(0,4.3,0),Vector3.new(3.8,2.1,3.8),Color3.fromRGB(112,165,85))
  detail("LeafTop",Vector3.new(-0.2,5.65,0.1),Vector3.new(2.8,0.7,2.8),Color3.fromRGB(153,195,105))
  detail("LeafHighlight",Vector3.new(0.7,5.25,-0.7),Vector3.new(1.8,0.25,1.5),Color3.fromRGB(174,210,119))
 else
  local stone=detail("Boulder",Vector3.new(0,1.15,0),Vector3.new(3.8,2.3,3.8),Color3.fromRGB(177,157,123))
  stone.CFrame*=CFrame.Angles(0,0,0.06)
  detail("StoneCap",Vector3.new(-0.3,2.5,0.15),Vector3.new(2.7,0.7,2.6),Color3.fromRGB(199,181,143))
  detail("Moss",Vector3.new(-0.6,2.91,0.1),Vector3.new(1.6,0.12,1.5),Color3.fromRGB(124,166,87))
  detail("StoneChip",Vector3.new(1.45,0.4,1.35),Vector3.new(0.9,0.8,0.9),Color3.fromRGB(163,146,113))
 end
end

function World.init(world, modelTemplate, config, rules)
	root, monsters, template, tuning, Rules = world, world.Monsters, modelTemplate, config.Prototype, rules
	monsterId = config.Monster.Id
	obstacles = Instance.new("Folder")
	obstacles.Name, obstacles.Parent = "Obstacles", root
	local preview = root:FindFirstChild("PreviewMonster")
	if preview then preview:Destroy() end
	local floor = root:FindFirstChild("PreviewGround")
	if floor then floor:Destroy() end
end

function World.spawn(position)
	local model = template:Clone()
	model.Name = monsterId
	model:SetAttribute("MonsterId", monsterId)
	model:SetAttribute("Occupied", false)
	model:SetAttribute("Running", true)
	model:SetAttribute("RunStarted", workspace:GetServerTimeNow() - (math.abs(position.X*0.17+position.Z*0.023)%1))
	model:SetAttribute("Steering", 0)
	model:PivotTo(CFrame.new(position))
	model.Parent = monsters
	spawnSerial+=1
	animals[model] = Motion.new(position.X,spawnSerial)
	return model
end

function World.ensure(z)
	local center = math.floor(z / tuning.GroundChunkStuds + 0.5)
	for index = center - 2, center + 1 do
		if chunks[index] or index*tuning.GroundChunkStuds &lt; -Course.LengthStuds-128 or index*tuning.GroundChunkStuds&gt;128 then continue end
		local chunk = Instance.new("Folder")
		chunk.Name, chunk.Parent = "Road_" .. index, root
		chunks[index] = chunk
		local start = index * tuning.GroundChunkStuds
		local meadow=part(chunk, "Meadow", Vector3.new(0,-1,start), Vector3.new(80,2,tuning.GroundChunkStuds), Color3.fromRGB(178,211,117))
  meadow.Material=Enum.Material.SmoothPlastic
		local random = Random.new(9101 + math.abs(index) * 137)
		for offset = -112,112,32 do
			local rowZ = start + offset
   if rowZ &lt; -Course.LengthStuds or rowZ&gt;128 then continue end
   local edge=Course.width(rowZ)
   local median=Course.median(rowZ)
   if median&gt;0 then
    decoration(chunk,"ForkRidge",Vector3.new(0,1.5,rowZ),Vector3.new(median*2,3,32),Color3.fromRGB(203,143,91))
    decoration(chunk,"ForkGrass",Vector3.new(0,3.1,rowZ),Vector3.new(median*2,0.2,32),Color3.fromRGB(133,179,96))
   end
   for _, side in ipairs({-1,1}) do
    local height=8+random:NextInteger(0,3)
    decoration(chunk,"CanyonBase",Vector3.new(side*(edge+5),2,rowZ),Vector3.new(10,4,32),Color3.fromRGB(220,151,97))
    decoration(chunk,"CanyonStratum",Vector3.new(side*(edge+7),4.5,rowZ),Vector3.new(10,1,32),Color3.fromRGB(249,191,128))
    decoration(chunk,"CanyonUpper",Vector3.new(side*(edge+9),5+height/2,rowZ),Vector3.new(12,height,32),Color3.fromRGB(201,126,80))
    decoration(chunk,"GrassCap",Vector3.new(side*(edge+9),5+height+0.25,rowZ),Vector3.new(12,0.5,32),Color3.fromRGB(122,170,92))
    decoration(chunk,"GrassEdge",Vector3.new(side*(edge-3),0.08,rowZ),Vector3.new(6,0.16,32),Color3.fromRGB(143,190,96))
    for i=1,3 do
     local z=rowZ+random:NextNumber(-14,14)
     local x=side*random:NextNumber(edge-3,edge-1)
     decoration(chunk,"GrassTuft",Vector3.new(x,0.45,z),Vector3.new(0.5,0.9,0.5),Color3.fromRGB(109,161,77))
    end
    if random:NextNumber()&lt;0.4 then
     local treeZ=rowZ+random:NextNumber(-8,8)
     decoration(chunk,"TreeTrunk",Vector3.new(side*(edge+13),5+height+2,treeZ),Vector3.new(1.4,4,1.4),Color3.fromRGB(152,99,67))
     decoration(chunk,"TreeCrown",Vector3.new(side*(edge+13),5+height+5,treeZ),Vector3.new(6,4,6),Color3.fromRGB(115,163,90))
     decoration(chunk,"TreeTop",Vector3.new(side*(edge+13),5+height+7,treeZ),Vector3.new(4,2,4),Color3.fromRGB(146,190,107))
    end
   end
   for i=1,3 do
    decoration(chunk,"MeadowPatch",Vector3.new(random:NextNumber(-29,29),0.025,rowZ+random:NextNumber(-14,14)),Vector3.new(random:NextNumber(2,5),0.05,random:NextNumber(3,8)),Color3.fromRGB(187,218,128))
   end
			-- Leave the run launch area clear; all other rows contain moving herds.
			if rowZ &lt; -20 or rowZ &gt; 30 then
				local lanes={}
    local ranges=Course.ranges(rowZ,4)
    for _,range in ipairs(ranges) do
     for i=1,4/#ranges do table.insert(lanes,range[1]+(range[2]-range[1])*i/(4/#ranges+1)) end
    end
    for _, x in ipairs(lanes) do
					if random:NextNumber() &lt; tuning.HerdSpawnChance then World.spawn(Vector3.new(x,2,rowZ)) end
				end
				if random:NextNumber() &lt; tuning.RockSpawnChance then
					local kind=(math.abs(index)*8+math.floor((offset+112)/32))%4
     local style=kind&gt;=2 and "Tree" or "MossyRock"
     local scale=kind%2==1 and 2 or 1
     local bounds=Course.ranges(rowZ-12,2*scale+2)
     local range=bounds[random:NextInteger(1,#bounds)]
     local x=random:NextNumber(range[1],range[2])
     local height=(style=="Tree" and 6 or 3)*scale
     local rock=part(obstacles,"Rock",Vector3.new(x,height/2,rowZ-12),Vector3.new(4*scale,height,4*scale),Color3.fromRGB(167,130,99))
     rock:SetAttribute("Chunk",index)
     rock.CanCollide=false -- server swept collision is authoritative
     dressObstacle(rock,style,scale)
				end
			end
		end
	end
end

function World.step(dt)
 local rocks={}
 for _,rock in ipairs(obstacles:GetChildren()) do
  if rock:IsA("BasePart") then table.insert(rocks,{x=rock.Position.X,z=rock.Position.Z,sx=rock.Size.X,sz=rock.Size.Z}) end
 end
	for model,motion in pairs(animals) do
		if not model.Parent then animals[model] = nil previousPositions[model]=nil continue end
		previousPositions[model] = model.PrimaryPart.Position
		if not model:GetAttribute("Occupied") then
			-- Only the authoritative root moves. Clients own all visual body poses.
   local p,half=model.PrimaryPart.Position,model.PrimaryPart.Size/2
   if motion.wasOccupied then motion.home,motion.vx,motion.wasOccupied=p.X,0,false end
   local x,z,vx=Motion.step(motion,p.X,p.Z,dt,rocks,tuning,half.X,half.Z,Rules,Course)
   model.PrimaryPart.CFrame=CFrame.new(x,p.Y,z)*CFrame.Angles(0,-math.atan2(vx,tuning.HerdStudsPerSecond),0)
   model:SetAttribute("Steering",vx/tuning.SidewaysStudsPerSecond)
		 model:SetAttribute("HerdVelocity",Vector3.new(vx,0,(z-p.Z)/math.max(dt,0.000001)))
		else motion.wasOccupied=true
		end
	end
end

function World.nearest(position, excluded)
	local best, bestDistance = nil, tuning.LassoRangeStuds * tuning.LassoRangeStuds
	for model in pairs(animals) do
		if not model.Parent or model==excluded or model:GetAttribute("Occupied") then continue end
		local delta = model.PrimaryPart.Position-position
		local distance = delta.X*delta.X+delta.Z*delta.Z
		if distance &lt;= bestDistance then best, bestDistance = model, distance end
	end
	return best
end

-- Contact while riding: include moving herds and the visible inner canyon face.
function World.mountedHit(from,to,mount)
 local half=mount.PrimaryPart.Size/2
 for i=0,4 do
  local p=from:Lerp(to,i/4)
  if not Course.contains(p.X,p.Z-half.Z,half.X) or not Course.contains(p.X,p.Z+half.Z,half.X) then return "Wall" end
 end
 for other in pairs(animals) do
  if other==mount or not other.Parent then continue end
  local old=previousPositions[other] or other.PrimaryPart.Position
  local current=other.PrimaryPart.Position
  local a,b=from-old,to-current
  local size=other.PrimaryPart.Size+mount.PrimaryPart.Size
  if Rules.sweptBox(a.X,a.Y,a.Z,b.X,b.Y,b.Z,0,0,0,size.X,size.Y,size.Z,0) then return "Monster" end
 end
 return nil
end

function World.hit(from, to)
	for _, rock in ipairs(obstacles:GetChildren()) do
		local p,s = rock.Position,rock.Size
		if Rules.sweptBox(from.X,from.Y,from.Z,to.X,to.Y,to.Z,p.X,p.Y,p.Z,s.X,s.Y,s.Z,1) then return true end
	end
	return false
end

-- Preserve each active runner's vicinity, and avoid unlimited course/animal growth.
function World.cleanup(nearZ)
	for index, chunk in pairs(chunks) do
		local keep = false
		for _, z in ipairs(nearZ) do if math.abs(index*tuning.GroundChunkStuds-z) &lt; tuning.GroundChunkStuds*4 then keep = true break end end
		if not keep then
			chunk:Destroy()
			chunks[index] = nil
			for _, rock in ipairs(obstacles:GetChildren()) do if rock:GetAttribute("Chunk") == index then rock:Destroy() end end
		end
	end
	for model in pairs(animals) do
		if not model.Parent then animals[model] = nil previousPositions[model]=nil continue end
		local keep = model:GetAttribute("Occupied")
		for _, z in ipairs(nearZ) do if math.abs(model.PrimaryPart.Position.Z-z) &lt; tuning.GroundChunkStuds*4 then keep = true break end end
		if not keep then model:Destroy() animals[model] = nil previousPositions[model]=nil end
	end
end

return World
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX171">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">40</float>
      <float name="CameraMinZoomDistance">8</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX172">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX173">
        <Properties>
          <string name="Name">CaptureClient</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local UIS=game:GetService("UserInputService")
local CAS=game:GetService("ContextActionService")
local player=Players.LocalPlayer
local package=RS:WaitForChild("RodeoFantasy")
local Config=require(package:WaitForChild("Config"))
local Rules=require(package:WaitForChild("HuntRules"))
local remote=package:WaitForChild("CaptureRemote")
local animator=require(script.Parent:WaitForChild("RideAnimator"))
local rider=require(script.Parent:WaitForChild("RiderPresentation"))
local gauge=require(script.Parent:WaitForChild("TamingGauge"))
local crashEffect=require(script.Parent:WaitForChild("CrashEffect"))
local audio=require(script.Parent:WaitForChild("AudioPresentation"))
local dash=require(script.Parent:WaitForChild("DashPresentation"))
local markers=require(script.Parent:WaitForChild("DistanceMarkers"))
local monsters=workspace:WaitForChild("RodeoPrototype"):WaitForChild("Monsters")
local state={phase="Idle",started=0,count=0,pending=0,distance=0}
local held,left,right=false,false,false
local pointerOrigin,pointerX,lastSteer=nil,nil,0
local notice,noticeUntil="",0
local flightFrame=nil
local savedType,savedSubject,savedFieldOfView=nil,nil,nil
local function make(kind,props,parent)
 local node=Instance.new(kind)
 for k,v in pairs(props) do node[k]=v end
 node.Parent=parent
 return node
end
local gui=make("ScreenGui",{Name="RodeoCaptureUI",ResetOnSpawn=false,DisplayOrder=10},player:WaitForChild("PlayerGui"))
local function text(parent,value,pos,size,font)
 return make("TextLabel",{Text=value,Position=pos,Size=size,TextSize=font or 18,Font=Enum.Font.GothamBold,TextColor3=Color3.fromRGB(255,245,219),BackgroundTransparency=1,TextWrapped=true},parent)
end
local distance=text(gui,"0m",UDim2.new(0.5,-80,0,12),UDim2.fromOffset(160,48),32)
local bag=text(gui,"가방: 0마리 · 모인 돈: 0원",UDim2.fromOffset(16,64),UDim2.fromOffset(320,32),14)
local panel=make("Frame",{Name="HuntHelp",AnchorPoint=Vector2.new(0.5,1),Position=UDim2.new(0.5,0,1,-20),Size=UDim2.new(0.9,0,0,94),BackgroundColor3=Color3.fromRGB(43,67,49),BackgroundTransparency=0.22,BorderSizePixel=0},gui)
make("UISizeConstraint",{MaxSize=Vector2.new(510,94)},panel)
make("UICorner",{CornerRadius=UDim.new(0,14)},panel)
local status=text(panel,"로데오 스트릿 · 루미돈 사냥",UDim2.fromOffset(12,4),UDim2.new(1,-24,0,28),18)
local instruction=text(panel,"A·D 좌우 이동 → 스페이스바 점프 → 다시 눌러 줄",UDim2.fromOffset(12,34),UDim2.new(1,-24,0,28),13)
local startButton=make("TextButton",{Name="StartHunt",AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.52),Size=UDim2.fromOffset(230,64),Text="사냥 시작",TextSize=24,Font=Enum.Font.GothamBold,TextColor3=Color3.new(1,1,1),BackgroundColor3=Color3.fromRGB(219,103,41)},gui)
make("UICorner",{CornerRadius=UDim.new(0,16)},startButton)
local highlight=make("Highlight",{Enabled=false,FillTransparency=0.82,OutlineColor=Color3.fromRGB(255,222,91)},gui)
local ring=make("Part",{Name="LocalLassoRange",Anchored=true,CanCollide=false,CanTouch=false,CanQuery=false,Transparency=1,Size=Vector3.new(1,1,1)},workspace)
local ringPoints={}
for i=1,32 do
 local a=make("Attachment",{},ring)
 local angle=(i-1)/32*math.pi*2
 a.Position=Vector3.new(math.cos(angle)*Config.Prototype.LassoRangeStuds,0,math.sin(angle)*Config.Prototype.LassoRangeStuds)
 ringPoints[i]=a
end
local beams={}
for i=1,32 do
 beams[i]=make("Beam",{Attachment0=ringPoints[i],Attachment1=ringPoints[i%32+1],Width0=0.12,Width1=0.12,FaceCamera=true,Color=ColorSequence.new(Color3.fromRGB(255,224,83)),Enabled=false},ring)
end
local function active() return state.phase~="Idle" and state.phase~="GameOver" and state.phase~="CourseEnd" end
local function steering()
 if state.phase~="Riding" then return 0 end
 if right or left then return (right and 1 or 0)-(left and 1 or 0) end
 if held and pointerOrigin and pointerX then
  local dx=pointerX-pointerOrigin
  return math.abs(dx)&lt;14 and 0 or math.clamp(dx/120,-1,1)
 end
 return 0
end
local function keyAction(_,inputState,input)
 if UIS:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end
 if state.phase~="Riding" then left,right=false,false return Enum.ContextActionResult.Sink end
 local down=inputState==Enum.UserInputState.Begin
 if inputState==Enum.UserInputState.Cancel then left,right=false,false else
  if input.KeyCode==Enum.KeyCode.A then left=down end
  if input.KeyCode==Enum.KeyCode.D then right=down end
 end
 return Enum.ContextActionResult.Sink
end
local function jumpAction(_,inputState)
 if UIS:GetFocusedTextBox() or not active() then return Enum.ContextActionResult.Pass end
 if inputState==Enum.UserInputState.Begin then remote:FireServer("Jump") end
 return Enum.ContextActionResult.Sink
end
local function cameraMode(enabled)
 local camera=workspace.CurrentCamera
 if enabled and savedType==nil then
  savedType,savedSubject,savedFieldOfView=camera.CameraType,camera.CameraSubject,camera.FieldOfView
  CAS:BindActionAtPriority("RodeoSteer",keyAction,false,Enum.ContextActionPriority.High.Value+1,Enum.KeyCode.A,Enum.KeyCode.D,Enum.KeyCode.W,Enum.KeyCode.S)
  CAS:BindActionAtPriority("RodeoJump",jumpAction,true,Enum.ContextActionPriority.High.Value+2,Enum.KeyCode.Space)
  CAS:SetTitle("RodeoJump","점프 / 줄")
  CAS:SetPosition("RodeoJump",UDim2.new(1,-95,1,-160))
  camera.CameraType=Enum.CameraType.Scriptable
  camera.FieldOfView=Config.Prototype.CameraFieldOfView
 elseif not enabled and savedType~=nil then
  CAS:UnbindAction("RodeoSteer")
  CAS:UnbindAction("RodeoJump")
  camera.CameraType=savedType
  camera.FieldOfView=savedFieldOfView
  if savedSubject and savedSubject.Parent then camera.CameraSubject=savedSubject end
  savedType,savedSubject,savedFieldOfView=nil,nil,nil
  held,left,right=false,false,false
 end
end
startButton.Activated:Connect(function() remote:FireServer("Start") end)
UIS.InputBegan:Connect(function(input,processed)
 if processed or not active() then return end
 if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
  held=true pointerOrigin,pointerX=input.Position.X,input.Position.X
 end
end)
UIS.InputChanged:Connect(function(input)
 if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then pointerX=input.Position.X end
end)
UIS.InputEnded:Connect(function(input)
 if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
  held=false
  pointerOrigin,pointerX=nil,nil
 end
end)
UIS.WindowFocusReleased:Connect(function()
 held,left,right=false,false,false
end)
remote.OnClientEvent:Connect(function(kind,data)
 if kind~="State" then return end
 if data.phase=="GameOver" and state.phase~="GameOver" and data.crash then crashEffect.start(player.Character,workspace:GetServerTimeNow()) end
 if data.phase~=state.phase then notice,noticeUntil="",0 end
 state=data
 if data.message then notice,noticeUntil=data.message,os.clock()+3 end
 startButton.Visible=not active()
 startButton.Text=state.phase=="GameOver" and "다시 사냥하기" or "사냥 시작"
 cameraMode(active() or state.phase=="CourseEnd")
 bag.Text=string.format("가방: %d마리 · 모인 돈: %d원",state.count,state.pending)
end)
player.CharacterAdded:Connect(function() state.phase="Idle" cameraMode(false) remote:FireServer("Sync") end)
RunService:BindToRenderStep("RodeoCapturePresentation", Enum.RenderPriority.Camera.Value+1, function(dt)
 local clock=workspace:GetServerTimeNow()
 local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 local frames=animator.update(monsters,clock,root and root.Position,dt)
 local t=Config.Prototype
 local visualFrame=root and root.CFrame
 if state.phase~="Airborne" then flightFrame=nil end
 if active() and root then
  local mount=state.monster and frames[state.monster]
  if (state.phase=="Riding" or state.phase=="CourseEnd") and mount then
   visualFrame=mount*CFrame.new(0,t.RideHeightStuds,t.RideForwardStuds)
  elseif state.phase=="Lassoing" and mount and state.origin then
   local p=math.clamp((clock-state.started)/(state.landingSeconds or t.JumpSeconds),0,1)
   visualFrame=state.origin:Lerp(mount*CFrame.new(0,t.RideHeightStuds,t.RideForwardStuds),p)*CFrame.new(0,math.sin(math.pi*p)*t.JumpArcStuds*0.5,0)
  elseif state.phase=="Airborne" and state.position and state.launchY then
   local elapsed=math.clamp(clock-(state.sampleTime or clock),0,0.3)
   local pos=state.position+Vector3.new(0,0,-t.AirStudsPerSecond)*elapsed
   local target=CFrame.new(math.clamp(pos.X,-t.RoadHalfWidth,t.RoadHalfWidth),state.launchY+Rules.jumpHeight(clock-state.started,t.FlightSeconds,t.JumpArcStuds),pos.Z)
   flightFrame=(flightFrame or root.CFrame):Lerp(target,1-math.exp(-22*dt))
   visualFrame=flightFrame
  end
 end
 rider.update(player.Character,state.phase,visualFrame,dt,clock,state.dashUntil)
 dash.update(state.phase,visualFrame,clock,state.dashUntil,t.SwitchDashSeconds)
 crashEffect.update(player.Character,state.phase,clock)
 audio.update(state,monsters,root and root.Position,clock)
 local displayDistance=state.distance or 0
 if active() then
  local speed=state.phase=="Airborne" and t.AirStudsPerSecond or Rules.rideSpeed(clock,state.phase=="Riding" and state.dashUntil,t.ForwardStudsPerSecond,t.SwitchDashMultiplier)
  displayDistance+=math.clamp(clock-(state.sampleTime or clock),0,0.3)*speed*t.MetersPerStud
 end
 markers.update(active() or state.phase=="CourseEnd",displayDistance,visualFrame,t.MetersPerStud)
 displayDistance=math.min(displayDistance,1000)
 distance.Text=string.format("%dm",math.floor(displayDistance))
 highlight.Enabled=false
 panel.Visible=not active()
 gauge.update(state.phase=="Riding" and state.monster and frames[state.monster] or nil,state.tamed and 1 or Rules.progress(clock-state.started,Config.Hunt.TameSeconds),state.tamed,workspace.CurrentCamera)
 for _,beam in ipairs(beams) do beam.Enabled=state.phase=="Airborne" end
 if (active() or state.phase=="CourseEnd") and root then
  -- Follow horizontal movement; jumping should not lift the whole view.
  local groundFocus=Vector3.new(0,t.CameraGroundFocusStuds,visualFrame.Position.Z)
  local target=CFrame.lookAt(groundFocus+Vector3.new(t.CameraSideStuds,t.CameraHeightStuds,t.CameraBehindStuds),groundFocus+Vector3.new(0,0,-t.CameraLookAheadStuds))
  -- The followed visual position is already smoothed; a second camera lag hides jumps.
  workspace.CurrentCamera.CFrame=target
  workspace.CurrentCamera.Focus=CFrame.new(groundFocus)
  if os.clock()-lastSteer&gt;=0.1 then remote:FireServer("Steer",steering()) lastSteer=os.clock() end
 end
 if state.phase=="Airborne" and root then
  ring.Position=Vector3.new(visualFrame.Position.X,0.15,visualFrame.Position.Z)
  local nearest,best=nil,Config.Prototype.LassoRangeStuds^2
  for _,model in ipairs(monsters:GetChildren()) do
   if model.PrimaryPart and model~=state.previousMonster and not model:GetAttribute("Occupied") then
    local d=model.PrimaryPart.Position-root.Position
    if d.X*d.X+d.Z*d.Z&lt;best then nearest,best=model,d.X*d.X+d.Z*d.Z end
   end
  end
  if nearest then highlight.Adornee,highlight.Enabled=nearest,true end
 end
 if state.phase=="Riding" then
  status.Text=state.angerAt and "화났어요! 스페이스바로 점프하세요!" or state.tamed and "길들이기 성공 · 계속 타고 달리세요" or "루미돈 길들이는 중 ♥"
  instruction.Text="A·D로 좌우 이동 · 스페이스바로 점프 / 공중에서 다시 누르면 줄"
  if clock&lt;(state.protectedUntil or 0) then
   instruction.Text=string.format("착지 보호 %.1f초 · A·D 좌우 이동 / 스페이스바 점프",state.protectedUntil-clock)
  end
 elseif state.phase=="Airborne" then
  status.Text="스페이스바로 다음 몬스터를 잡으세요!"
  instruction.Text="노란 원 안에 몬스터가 들어오면 줄이 연결됩니다"
 elseif state.phase=="Lassoing" then status.Text="날아가서 탑승하는 중…" instruction.Text="탑승 후 계속 타고 달릴 수 있어요"
 elseif state.phase=="CourseEnd" then status.Text="1,000m · 다음 지역 준비 중" instruction.Text="초원 시험 구간이 끝났어요 · 사냥 시작으로 다시 달릴 수 있어요"
 elseif state.phase=="GameOver" then status.Text="사냥 종료" instruction.Text="다시 사냥하기로 재도전 · 가방 수익은 유지"
 else status.Text="로데오 스트릿 · 루미돈 사냥" instruction.Text="사냥 시작 → A·D 좌우 이동 → 스페이스바 점프 → 다시 눌러 줄" end
 if os.clock()&lt;noticeUntil and not state.angerAt then status.Text=notice end
end)
remote:FireServer("Sync")
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX174">
        <Properties>
          <string name="Name">RideAnimator</string>
          <ProtectedString name="Source">-- Procedural visual motion for the native part model. Never changes its mount root.
local RideAnimator = {}
local poses = {}
local warnings = {}
local package = game:GetService("ReplicatedStorage"):WaitForChild("RodeoFantasy")
local template = package:WaitForChild("VisualTemplate")
local tuning = require(package:WaitForChild("Config")).Prototype
local Rules = require(package:WaitForChild("HuntRules"))
local restFrames = {}
local dust={}
local function clearHerdPath(from,to,root)
 local world=workspace:FindFirstChild("RodeoPrototype")
 local obstacles=world and world:FindFirstChild("Obstacles")
 if not obstacles then return true end
 for _,rock in ipairs(obstacles:GetChildren()) do
  if not rock:IsA("BasePart") then continue end
  local p,s=rock.Position,rock.Size+root.Size
  if Rules.sweptBox(from.X,from.Y,from.Z,to.X,to.Y,to.Z,p.X,p.Y,p.Z,s.X,s.Y,s.Z,0.2) then return false end
 end
 return true
end
for _, part in ipairs(template:GetDescendants()) do
 if part:IsA("BasePart") and part ~= template.PrimaryPart then
  restFrames[part.Name] = template.PrimaryPart.CFrame:ToObjectSpace(part.CFrame)
 end
end

local function remember(model)
	local root = model.PrimaryPart
	if not root then return nil end
	local pose = {frame = root.CFrame, sample = root.CFrame, received = nil}
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") and part ~= root then
			local side = string.sub(part.Name,1,4)=="Left" and "Left" or string.sub(part.Name,1,5)=="Right" and "Right" or nil
			local movingLeg = side and (string.find(part.Name,"Leg",1,true) or string.find(part.Name,"Paw",1,true) or string.find(part.Name,"HoofLine",1,true))
			local leg = movingLeg and (string.find(part.Name,"Front",1,true) and "Front" or "Back") or nil
			if not leg then side=nil end
			table.insert(pose, { part = part, rest = restFrames[part.Name] or root.CFrame:ToObjectSpace(part.CFrame), side = side, leg = leg })
		end
	end
	poses[model] = pose
	return pose
end

function RideAnimator.update(monsters, clock, cameraPosition, dt)
 dt = dt or 1/60
 for i=#dust,1,-1 do
  local puff=dust[i] local age=clock-puff.started
  if age&gt;=0.45 then puff.part:Destroy() table.remove(dust,i)
  else puff.part.Transparency=0.55+age puff.part.Size=Vector3.one*(0.45+age*1.5) puff.part.Position+=Vector3.new(0,dt*0.7,0) end
 end
 local displayed = {}
	for model, pose in pairs(poses) do
		if model.Parent ~= monsters then poses[model] = nil end
	end
	for model, warning in pairs(warnings) do
		if model.Parent ~= monsters then warning:Destroy() warnings[model] = nil end
	end
	for _, model in ipairs(monsters:GetChildren()) do
		local root = model.PrimaryPart
		if not root then continue end
  local nameplate = root:FindFirstChild("Nameplate")
  if nameplate then nameplate.Enabled = model:GetAttribute("Running") ~= true end
		if cameraPosition then
   local hidden=(root.Position-cameraPosition).Magnitude&gt;220
   for _,part in ipairs(model:GetChildren()) do
    if part:IsA("BasePart") and part~=root then part.LocalTransparencyModifier=hidden and 1 or 0 end
   end
   if hidden then continue end
  end
		local running = model:GetAttribute("Running") == true
		local pose = poses[model]
		if not pose and not running then continue end
		pose = pose or remember(model)
  if pose.sample ~= root.CFrame or not pose.received then
   pose.sample, pose.received = root.CFrame, clock
  end
  local elapsed = math.clamp(clock-pose.received,0,0.08)
  local speed = model:GetAttribute("Occupied") and Rules.rideSpeed(clock,model:GetAttribute("DashUntil"),tuning.ForwardStudsPerSecond,tuning.SwitchDashMultiplier) or tuning.HerdStudsPerSecond
  local steer = model:GetAttribute("Steering") or 0
  local velocity=Vector3.new(steer*tuning.SidewaysStudsPerSecond,0,-speed)
  if not model:GetAttribute("Occupied") then velocity=model:GetAttribute("HerdVelocity") or velocity end
  local target = pose.sample + velocity*(running and elapsed or 0)
  if not model:GetAttribute("Occupied") and not clearHerdPath(pose.sample.Position,target.Position,root) then target=pose.sample end
  if (target.Position-pose.frame.Position).Magnitude&gt;30 or not running then
   pose.frame = target
  else
   local blended=pose.frame:Lerp(target,1-math.exp(-22*dt))
   if not model:GetAttribute("Occupied") and not clearHerdPath(pose.frame.Position,blended.Position,root) then blended=pose.sample end
   pose.frame = blended
  end

		local phase = (clock - (model:GetAttribute("RunStarted") or clock)) * math.pi * 7
		local angry = model:GetAttribute("Angry") == true
		local warningActive = model:GetAttribute("AngerWarning") == true or angry
		local warning = warnings[model]
		if warningActive and not warning then
			warning = Instance.new("BillboardGui")
			warning.Name, warning.Size, warning.StudsOffset = "AngerWarning", UDim2.fromOffset(60, 70), Vector3.new(0, 4.5, 0)
			warning.AlwaysOnTop, warning.Adornee, warning.Parent = true, root, root
			local label = Instance.new("TextLabel")
			label.Size, label.BackgroundTransparency, label.Text = UDim2.fromScale(1, 1), 1, "!"
			label.Font, label.TextSize = Enum.Font.GothamBlack, 58
			label.TextColor3, label.TextStrokeTransparency = Color3.fromRGB(255, 104, 55), 0
			label.Parent = warning
			warnings[model] = warning
		end
		if warning then
   warning.Enabled = warningActive
   local label=warning:FindFirstChildWhichIsA("TextLabel")
   if label then label.TextTransparency=0.15+math.max(0,math.sin(clock*12))*0.45 end
  end
		local _,_,pitch=Rules.buck(clock-(model:GetAttribute("AngerStarted") or clock),tuning.BuckCycleSeconds,tuning.BuckHeightStuds)
		local lean = running and (model:GetAttribute("Steering") or 0) * -0.18 or 0
  local moving=running and velocity.Magnitude&gt;1
  local bounce=moving and (1-math.cos(phase))*0.22 or 0
  local gallopPitch=moving and math.sin(phase)*0.085 or 0
		local frame = pose.frame * CFrame.new(0,bounce,0)*CFrame.Angles(angry and pitch or gallopPitch, 0, lean)
  if moving and not model:GetAttribute("Occupied") and clock-(pose.lastDust or clock-1)&gt;0.14 and #dust&lt;80 then
   pose.lastDust=clock
   local puff=Instance.new("Part") puff.Name="LocalHerdDust" puff.Anchored=true
   puff.CanCollide,puff.CanTouch,puff.CanQuery=false,false,false
   puff.Color=Color3.fromRGB(239,220,176) puff.Size=Vector3.one*0.45 puff.Transparency=0.55
   puff.Position=Vector3.new(frame.X+math.sin(phase)*0.9,0.2,frame.Z+1.6)
   puff.Parent=workspace table.insert(dust,{part=puff,started=clock})
  end
  displayed[model] = frame
		for _, entry in ipairs(pose) do
			if not entry.part.Parent then continue end
			local localFrame = entry.rest
			if moving and entry.side then
				local opposite = (entry.side == "Left") ~= (entry.leg == "Front")
				local swing = math.sin(phase + (opposite and math.pi or 0)) * 0.85
				local joint = CFrame.new(entry.side == "Left" and -0.88 or 0.88, -0.87, entry.leg == "Front" and -0.91 or 1.17)
				localFrame = CFrame.new(0,math.max(0,math.sin(phase + (opposite and math.pi or 0)))*0.22,0) * joint * CFrame.Angles(swing, 0, 0) * joint:Inverse() * entry.rest
			end
   if running and entry.part.Name:find("Ear") then
    local sign=entry.part.Name:find("Left") and -1 or 1
    local pivot=CFrame.new(sign*0.87,1.3,-1.21)
    localFrame=pivot*CFrame.Angles(math.sin(phase)*0.12,0,sign*math.sin(phase)*0.1)*pivot:Inverse()*localFrame
   elseif running and entry.part.Name:find("Tail") then
    local pivot=CFrame.new(0,-0.1,1.7)
    localFrame=pivot*CFrame.Angles(0,math.sin(phase*0.65)*0.3,0)*pivot:Inverse()*localFrame
   end
			entry.part.CFrame = frame * localFrame
		end
		if not running then poses[model] = nil end
	end
 return displayed
end

return RideAnimator
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX175">
        <Properties>
          <string name="Name">RiderPresentation</string>
          <ProtectedString name="Source">-- Local presentation only; server still owns capture, movement and collisions.
local Presentation = {}
local character, animate, animateDisabled
local joints, dust = {}, {}
local constraints={}
-- Transform is evaluated by the avatar animator before physics each frame.
game:GetService("RunService").PreSimulation:Connect(function()
 for joint,rest in pairs(constraints) do
  if joint.Parent and rest.pose then joint.Transform=rest.pose end
 end
end)
local lastDust = 0
local shadow, trail, trailEnd
local rope, ropePoints, ropeTail
local previousPhase
local function restore()
 for joint,rest in pairs(joints) do if joint.Parent then joint.C0=rest end end
 if animate and animate.Parent then animate.Disabled=animateDisabled end
 for joint,rest in pairs(constraints) do if joint.Parent then joint.Transform=rest.transform end end
 constraints={}
 joints={}
 if shadow then shadow:Destroy() shadow=nil end
 if trail then trail.Parent:Destroy() trail=nil end
 if trailEnd then trailEnd:Destroy() trailEnd=nil end
 if rope then rope:Destroy() rope=nil end
 previousPhase=nil
 character,animate=nil,nil
end
function Presentation.update(model,phase,frame,dt,clock,dashUntil)
 local active=phase~="Idle" and phase~="GameOver"
 if character and (character~=model or not active) then restore() end
 local root=model and model:FindFirstChild("HumanoidRootPart")
 if active and root and not character then
  character=model
  animate=model:FindFirstChild("Animate")
  if animate then animateDisabled=animate.Disabled animate.Disabled=true end
  local humanoid=model:FindFirstChildOfClass("Humanoid")
  local animator=humanoid and humanoid:FindFirstChildOfClass("Animator")
  if animator then for _,track in ipairs(animator:GetPlayingAnimationTracks()) do track:Stop(0) end end
  for _,joint in ipairs(model:GetDescendants()) do
   if joint:IsA("Motor6D") then joints[joint]=joint.C0 joint.Transform=CFrame.identity
   elseif joint:IsA("AnimationConstraint") and joint.Attachment0 then
    constraints[joint]={frame=joint.Attachment0.CFrame,transform=joint.Transform,pose=CFrame.identity}
    joint.Transform=CFrame.identity
   end
  end
  shadow=Instance.new("Part")
  shadow.Name="LocalRiderShadow"
  shadow.Shape=Enum.PartType.Cylinder
  shadow.Size=Vector3.new(0.04,4,4)
  shadow.Color=Color3.fromRGB(71,89,54)
  shadow.Transparency=0.65
  shadow.Anchored,shadow.CanCollide,shadow.CanTouch,shadow.CanQuery=true,false,false,false
  shadow.Parent=workspace
  local a=Instance.new("Attachment") a.Name="FlightTrailAnchor" a.Position=Vector3.new(-0.7,0,0) a.Parent=root
  local b=Instance.new("Attachment") b.Name="FlightTrailEnd" b.Position=Vector3.new(0.7,0,0) b.Parent=a
  -- Both attachments must be parented to the root to use its coordinate space.
  b.Parent=root trailEnd=b
  trail=Instance.new("Trail") trail.Attachment0,trail.Attachment1=a,b
  trail.Color=ColorSequence.new(Color3.fromRGB(255,236,172))
  trail.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.45),NumberSequenceKeypoint.new(1,1)})
  trail.Lifetime,trail.FaceCamera,trail.Parent=0.18,true,a
 end
 if active and root and frame then
  -- Parts and joints may arrive after HumanoidRootPart during character replication.
  for _,joint in ipairs(model:GetDescendants()) do
   if joint:IsA("Motor6D") and not joints[joint] then joints[joint]=joint.C0 joint.Transform=CFrame.identity
   elseif joint:IsA("AnimationConstraint") and joint.Attachment0 and not constraints[joint] then
    constraints[joint]={frame=joint.Attachment0.CFrame,transform=joint.Transform,pose=CFrame.identity}
   end
  end
  local airborne=phase=="Airborne" or phase=="Lassoing"
  root.CFrame=frame * CFrame.Angles(airborne and -0.5 or 0,0,0)
  local function poseOffset(name)
   name=name:gsub(" ","")
   local offset=CFrame.identity
   if name:find("Shoulder") then
    local side=name:find("Left") and -1 or 1
    offset=airborne and CFrame.Angles(0,0,side*math.pi/2) or (side==1 and CFrame.Angles(0.12*math.sin(clock*15),0,2.65) or CFrame.Angles(0.65,0,-0.15))
   elseif name:find("Hip") then
    local side=name:find("Left") and -1 or 1
    offset=CFrame.Angles(airborne and 0 or 1.2,0,side*(airborne and 0.65 or 0.3))
   elseif name:find("Knee") then offset=CFrame.Angles(airborne and 0 or -1.2,0,0)
   elseif name=="Waist" then offset=CFrame.Angles(airborne and 0.08 or 0.15,0,0) end
   return offset
  end
  for joint,rest in pairs(joints) do
   if not joint.Parent then joints[joint]=nil continue end
   local target=CFrame.new(rest.Position)*poseOffset(joint.Name)*rest.Rotation
   joint.C0=joint.C0:Lerp(target,1-math.exp(-18*dt))
  end
  -- Upgraded R15 avatars have AnimationConstraints rather than Motor6Ds.
  for joint,rest in pairs(constraints) do
   if not joint.Parent then constraints[joint]=nil continue end
   local target=CFrame.new(rest.frame.Position)*poseOffset(joint.Name)*rest.frame.Rotation
   rest.pose=rest.pose:Lerp(rest.frame:Inverse()*target,1-math.exp(-18*dt))
   joint.Transform=rest.pose
  end
  if phase=="Riding" then
   if not rope then
    rope=Instance.new("Part") rope.Name="LocalCowboyLasso"
    rope.Anchored,rope.CanCollide,rope.CanTouch,rope.CanQuery=true,false,false,false
    rope.Transparency=1 rope.Size=Vector3.one rope.Parent=workspace
    ropePoints={}
    for i=1,24 do local a=Instance.new("Attachment") a.Parent=rope ropePoints[i]=a end
    ropeTail=Instance.new("Attachment") ropeTail.Parent=rope
    for i=1,25 do
     local beam=Instance.new("Beam")
     beam.Attachment0=i==25 and ropeTail or ropePoints[i]
     beam.Attachment1=i==25 and ropePoints[1] or ropePoints[i%24+1]
     beam.Width0,beam.Width1,beam.FaceCamera=0.09,0.09,true
     beam.Color=ColorSequence.new(Color3.fromRGB(236,192,101)) beam.Parent=rope
    end
   end
   rope.CFrame=root.CFrame
   local hand=model:FindFirstChild("RightHand") or model:FindFirstChild("Right Arm")
   ropeTail.Position=hand and root.CFrame:PointToObjectSpace(hand.Position) or Vector3.new(1,2,0)
   local spin=CFrame.new(0.6,2.8,0)*CFrame.Angles(0,(clock*15)%(math.pi*2),0)*CFrame.Angles(0.25,0,0)
   for i,a in ipairs(ropePoints) do
    local angle=(i-1)/24*math.pi*2
    a.Position=spin:PointToWorldSpace(Vector3.new(math.cos(angle)*1.7,0,math.sin(angle)*1.25))
   end
  elseif rope then rope:Destroy() rope=nil end
  shadow.CFrame=CFrame.new(frame.X,0.055,frame.Z)*CFrame.Angles(0,0,math.pi/2)
  shadow.Transparency=airborne and 0.5 or 0.75
  trail.Enabled=airborne or (phase=="Riding" and dashUntil~=nil and clock&lt;dashUntil)
  if phase=="Riding" and previousPhase and previousPhase~="Riding" then
   for i=1,8 do
    local puff=Instance.new("Part") puff.Name="LocalLandingDust"
    puff.Anchored,puff.CanCollide,puff.CanTouch,puff.CanQuery=true,false,false,false
    puff.Color=Color3.fromRGB(239,220,176) puff.Size=Vector3.one*0.7 puff.Transparency=0.45
    local angle=i/8*math.pi*2
    puff.Position=Vector3.new(frame.X+math.cos(angle)*2,0.3,frame.Z+math.sin(angle)*2)
    puff.Parent=workspace table.insert(dust,{part=puff,started=clock})
   end
  end
  previousPhase=phase
  if phase=="Riding" and clock-lastDust&gt;0.08 then
   lastDust=clock
   local puff=Instance.new("Part")
   puff.Name="LocalHoofDust" puff.Anchored=true
   puff.CanCollide,puff.CanTouch,puff.CanQuery=false,false,false
   puff.Color=Color3.fromRGB(239,220,176) puff.Material=Enum.Material.SmoothPlastic
   puff.Size=Vector3.new(0.5,0.5,0.5) puff.Transparency=0.45
   puff.Position=Vector3.new(frame.X+math.sin(clock*31),0.3,frame.Z+2)
   puff.Parent=workspace
   table.insert(dust,{part=puff,started=clock})
   local streak=puff:Clone() streak.Name="LocalSpeedStreak"
   streak.Size=Vector3.new(0.08,0.04,3.5) streak.Transparency=0.65
   streak.Position=Vector3.new(frame.X+math.sin(clock*17)*8,0.08,frame.Z-9)
   streak.Parent=workspace table.insert(dust,{part=streak,started=clock,streak=true})
  end
 end
 for i=#dust,1,-1 do
  local entry=dust[i] local p=(clock-entry.started)/0.45
  if p&gt;=1 then entry.part:Destroy() table.remove(dust,i)
  else
   entry.part.Transparency=0.45+p*0.55
   if not entry.streak then entry.part.Size=Vector3.one*(0.5+p*0.65) end
   entry.part.Position+=Vector3.new(0,entry.streak and 0 or dt*0.6,0)
  end
 end
end
function Presentation.clear() restore() end
return Presentation
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX176">
        <Properties>
          <string name="Name">TamingGauge</string>
          <ProtectedString name="Source">-- Original, asset-free circular taming indicator following the rendered mount.
local Gauge={}
local anchor,billboard,heart
local segments={}
local function create()
 anchor=Instance.new("Part")
 anchor.Name="LocalTamingGaugeAnchor" anchor.Anchored=true anchor.Transparency=1
 anchor.CanCollide,anchor.CanTouch,anchor.CanQuery=false,false,false
 anchor.Size=Vector3.one anchor.Parent=workspace
 billboard=Instance.new("BillboardGui")
 billboard.Name="MountedTamingGauge" billboard.Size=UDim2.fromOffset(82,82)
 billboard.AlwaysOnTop=true billboard.Adornee=anchor billboard.Parent=anchor
 local disk=Instance.new("Frame") disk.Size=UDim2.fromScale(1,1)
 disk.BackgroundColor3=Color3.fromRGB(66,61,48) disk.BackgroundTransparency=0.15 disk.BorderSizePixel=0 disk.Parent=billboard
 local corner=Instance.new("UICorner") corner.CornerRadius=UDim.new(1,0) corner.Parent=disk
 for i=1,64 do
  local angle=(i-0.5)/64*math.pi*2-math.pi/2
  local segment=Instance.new("Frame")
  segment.Name="Arc"..i segment.AnchorPoint=Vector2.new(0.5,0.5)
  segment.Position=UDim2.fromScale(0.5+math.cos(angle)*0.44,0.5+math.sin(angle)*0.44)
  segment.Size=UDim2.fromOffset(7,4.3) segment.Rotation=math.deg(angle)
  segment.BorderSizePixel=0 segment.BackgroundColor3=Color3.fromRGB(106,99,78) segment.Parent=disk
  segments[i]=segment
 end
 heart=Instance.new("TextLabel") heart.Name="Heart" heart.Size=UDim2.fromScale(1,1)
 heart.BackgroundTransparency=1 heart.Text="♥" heart.Font=Enum.Font.GothamBlack
 heart.TextSize=44 heart.TextColor3=Color3.fromRGB(255,139,209) heart.Parent=disk
end
function Gauge.update(frame,progress,tamed,camera)
 if not frame or tamed then if billboard then billboard.Enabled=false end return end
 if not anchor then create() end
 billboard.Enabled=true
 -- Screen-relative lower-left of the mount, without covering its body or the rider.
 local right=camera and camera.CFrame.RightVector or Vector3.xAxis
 local up=camera and camera.CFrame.UpVector or Vector3.yAxis
 anchor.CFrame=CFrame.new(frame.Position-right*4.5-up*2.5)
 local completed=math.floor(math.clamp(progress,0,1)*64+0.0001)
 for i,segment in ipairs(segments) do
  segment.BackgroundColor3=i&lt;=completed and Color3.fromRGB(255,137,207) or Color3.fromRGB(106,99,78)
 end
 heart.Text="♥"
 heart.TextTransparency=0.1
end
return Gauge
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX177">
        <Properties>
          <string name="Name">CrashEffect</string>
          <ProtectedString name="Source">-- Cartoon breakup using temporary visual clones; never destroys the real avatar.
local Effect={}
local shards,hidden={},{}
local character,started
local function clear()
 for _,entry in ipairs(shards) do entry.part:Destroy() end
 for part,value in pairs(hidden) do if part.Parent then part.LocalTransparencyModifier=value end end
 shards,hidden={},{}
 character,started=nil,nil
end
function Effect.start(model,clock)
 clear()
 if not model then return end
 character,started=model,clock
 local root=model:FindFirstChild("HumanoidRootPart")
 local center=root and root.Position or Vector3.zero
 local index=0
 for _,original in ipairs(model:GetDescendants()) do
  if not original:IsA("BasePart") then continue end
  hidden[original]=original.LocalTransparencyModifier
  original.LocalTransparencyModifier=1
  if original.Name=="HumanoidRootPart" or original.Transparency&gt;=1 then continue end
  index+=1
  local archived=original.Archivable original.Archivable=true
  local shard=original:Clone() original.Archivable=archived
  for _,item in ipairs(shard:GetDescendants()) do
   if item:IsA("JointInstance") or item:IsA("Constraint") or item:IsA("LuaSourceContainer") or item:IsA("Attachment") or item:IsA("ParticleEmitter") or item:IsA("Sound") or item:IsA("Trail") or item:IsA("Beam") then item:Destroy() end
  end
  shard.Name="LocalCrashShard" shard.Anchored=true
  shard.LocalTransparencyModifier=0
  shard.CanCollide,shard.CanTouch,shard.CanQuery=false,false,false
  shard.Parent=workspace
  local direction=original.Position-center
  local radial=Vector3.new(direction.X,0,direction.Z)
  if radial.Magnitude&lt;0.1 then radial=Vector3.new(math.cos(index*2.4),0,math.sin(index*2.4)) end
  local velocity=radial.Unit*12+Vector3.new(0,12+index%4,10)
  table.insert(shards,{part=shard,origin=shard.CFrame,velocity=velocity,alpha=original.Transparency,spin=Vector3.new(index%3+1,1,index%2+1)})
 end
end
function Effect.update(model,phase,clock)
 if character and (model~=character or phase~="GameOver") then clear() end
 if not started then return end
 for part in pairs(hidden) do if part.Parent then part.LocalTransparencyModifier=1 end end
 local elapsed=clock-started
 for i=#shards,1,-1 do
  local entry=shards[i]
  if elapsed&gt;=1.15 then entry.part:Destroy() table.remove(shards,i)
  else
   local position=entry.origin.Position+entry.velocity*elapsed+Vector3.new(0,-20*elapsed*elapsed,0)
   position=Vector3.new(position.X,math.max(0.3,position.Y),position.Z)
   local spin=entry.spin*elapsed*4
   entry.part.CFrame=CFrame.new(position)*entry.origin.Rotation*CFrame.Angles(spin.X,spin.Y,spin.Z)
   entry.part.Transparency=entry.alpha+(1-entry.alpha)*math.clamp((elapsed-0.65)/0.5,0,1)
  end
 end
end
function Effect.clear() clear() end
return Effect
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX178">
        <Properties>
          <string name="Name">DistanceMarkers</string>
          <ProtectedString name="Source">-- Local course markings projected from the server's run distance, not global map Z.
local Markers={}
local gates={}
local function create(distance)
 local model=Instance.new("Model") model.Name="LocalDistanceMarker" model:SetAttribute("Meters",distance)
 local function part(name,size,pos,color)
  local p=Instance.new("Part") p.Name=name p.Size=size p.Position=pos p.Color=color
  p.Anchored,p.CanCollide,p.CanTouch,p.CanQuery=true,false,false,false p.Parent=model return p
 end
 for i=0,19 do
  part("FinishStripe",Vector3.new(3.5,0.04,1.5),Vector3.new(-33.25+i*3.5,0.04,0),i%2==0 and Color3.fromRGB(255,242,203) or Color3.fromRGB(238,134,97))
 end
 for _,side in ipairs({-1,1}) do
  part("Post",Vector3.new(0.6,6,0.6),Vector3.new(side*33,3,0),Color3.fromRGB(112,85,62))
  local board=part("DistanceSign",Vector3.new(7,3,0.4),Vector3.new(side*30,6,0),Color3.fromRGB(63,104,79))
  local gui=Instance.new("SurfaceGui") gui.Face=Enum.NormalId.Back gui.CanvasSize=Vector2.new(560,240) gui.Parent=board
  local label=Instance.new("TextLabel") label.Size=UDim2.fromScale(1,1) label.BackgroundTransparency=1
  label.Text=tostring(distance).."m" label.TextColor3=Color3.fromRGB(255,242,203) label.Font=Enum.Font.GothamBold label.TextScaled=true label.Parent=gui
 end
 model.WorldPivot=CFrame.identity model.Parent=workspace return model
end
function Markers.update(active,distance,frame,metersPerStud)
 if not active or not frame then
  for _,gate in pairs(gates) do gate.model:Destroy() end gates={} return
 end
 local nextDistance=1000 -- only the first meadow is implemented
 for value,gate in pairs(gates) do
  if value&lt;nextDistance-1000 or value&gt;nextDistance then gate.model:Destroy() gates[value]=nil end
 end
 -- Keep one forthcoming marker; refresh its projection as flying changes travel speed.
 local gate=gates[nextDistance]
 if not gate then gate={model=create(nextDistance)} gates[nextDistance]=gate end
 gate.model:PivotTo(CFrame.new(0,0,frame.Z-(nextDistance-distance)/metersPerStud))
end
return Markers
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX179">
        <Properties>
          <string name="Name">AudioPresentation</string>
          <ProtectedString name="Source">local Audio={}
local service=game:GetService("SoundService")
local config=require(game:GetService("ReplicatedStorage"):WaitForChild("RodeoFantasy"):WaitForChild("Config"))
local sounds,hooves={},{}
local previousPhase,previousCount=nil,nil
local function sound(name,id,parent,volume,looped)
 local s=Instance.new("Sound") s.Name=name s.SoundId=id s.Volume=volume
 s.Looped=looped or false s.Parent=parent return s
end
local function initialize()
 if sounds.BGM then return end
 for _,kind in ipairs({"BGM","Jump","Rope","Land","Success"}) do
  sounds[kind]=sound("Rodeo"..kind,config.Audio[kind],service,kind=="BGM" and config.Audio.MusicVolume or config.Audio.EffectsVolume,kind=="BGM")
 end
 sounds.Rope.Volume=0.18 sounds.Success.PlaybackSpeed=1.4
 sounds.BGM:Play()
end
local function play(kind)
 local s=sounds[kind] s:Stop() s.TimePosition=0 s:Play()
end
function Audio.update(state,monsters,position,clock)
 initialize()
 local active=state.phase~="Idle" and state.phase~="GameOver" and state.phase~="CourseEnd"
 if previousPhase and previousPhase~=state.phase then
  if state.phase=="Airborne" then play("Jump")
  elseif state.phase=="Lassoing" then play("Rope")
  elseif state.phase=="Riding" then play("Land") end
 end
 if previousCount and (state.count or 0)&gt;previousCount then play("Success") end
 previousPhase,previousCount=state.phase,state.count or 0
 local candidates={}
 if active and position then
  for _,model in ipairs(monsters:GetChildren()) do
   local root=model.PrimaryPart
   local velocity=model:GetAttribute("HerdVelocity")
   local moving=model:GetAttribute("Occupied") or not velocity or velocity.Magnitude&gt;1
   if root and model:GetAttribute("Running") and moving then
    local distance=(root.Position-position).Magnitude
    if distance&lt;70 then table.insert(candidates,{model=model,distance=distance}) end
   end
  end
 end
 table.sort(candidates,function(a,b) return a.distance&lt;b.distance end)
 local kept={}
 for i=1,math.min(6,#candidates) do
  local model=candidates[i].model kept[model]=true
  local s=hooves[model]
  if not s then
   s=sound("RodeoHooves",config.Audio.Hooves,model.PrimaryPart,0.16,true)
   s.RollOffMinDistance,s.RollOffMaxDistance=6,70
   s.RollOffMode=Enum.RollOffMode.InverseTapered hooves[model]=s s:Play()
  end
  local dash=model:GetAttribute("DashUntil")
  s.PlaybackSpeed=dash and clock&lt;dash and 1.5 or 1
 end
 for model,s in pairs(hooves) do
  if not kept[model] or not model.Parent then s:Destroy() hooves[model]=nil end
 end
end
return Audio
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX180">
        <Properties>
          <string name="Name">DashPresentation</string>
          <ProtectedString name="Source">-- Local wind geometry, active only during the existing switch dash.
local Dash={}
local anchor,points,beams
local function clear()
 if anchor then anchor:Destroy() anchor=nil end
end
function Dash.update(phase,frame,clock,untilTime,duration)
 if phase~="Riding" or not frame or not untilTime or clock&gt;=untilTime then clear() return end
 if not anchor then
  anchor=Instance.new("Part") anchor.Name="LocalDashWind"
  anchor.Anchored=true anchor.Transparency=1 anchor.Size=Vector3.one
  anchor.CanCollide,anchor.CanTouch,anchor.CanQuery=false,false,false
  anchor.Parent=workspace points={} beams={}
  for i=1,80 do local a=Instance.new("Attachment") a.Parent=anchor points[i]=a end
  for i=1,72 do
   local beam=Instance.new("Beam") beam.FaceCamera=true
   if i&lt;=64 then
    local group=math.floor((i-1)/32)*32
    beam.Attachment0=points[i] beam.Attachment1=points[group+i%32+1]
   else beam.Attachment0=points[65+(i-65)*2] beam.Attachment1=points[66+(i-65)*2] end
   beam.Width0,beam.Width1=0.16,0.08
   beam.Color=ColorSequence.new(Color3.fromRGB(255,249,222))
   beam.LightEmission=0.2 beam.Parent=anchor beams[i]=beam
  end
 end
 anchor.CFrame=frame*CFrame.new(0,-1,0)
 local progress=math.clamp(1-(untilTime-clock)/duration,0,1)
 for group=0,1 do
  local radius=3.2+progress*3+group*0.9
  for i=1,32 do
   local angle=(i-1)/32*math.pi*2
   points[group*32+i].Position=Vector3.new(math.cos(angle)*radius,math.sin(angle)*radius,1+progress*7+group*3)
  end
 end
 for i=0,7 do
  local angle=i/8*math.pi*2+0.2
  local radius=3.7+math.sin(clock*20+i)*0.3
  local start=Vector3.new(math.cos(angle)*radius,math.sin(angle)*radius,-3)
  points[65+i*2].Position=start
  points[66+i*2].Position=start+Vector3.new(0,0,5+progress*6)
 end
 for _,beam in ipairs(beams) do beam.Transparency=NumberSequence.new(0.45+progress*0.55) end
end
return Dash
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Lighting" referent="RBX181">
    <Properties>
      <string name="Name">Lighting</string>
      <float name="ClockTime">13</float>
      <float name="Brightness">2</float>
      <Color3 name="Ambient">
        <R>0.65</R>
        <G>0.62</G>
        <B>0.56</B>
      </Color3>
    </Properties>
  </Item>
</roblox>