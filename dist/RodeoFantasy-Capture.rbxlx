  <Item class="ReplicatedStorage" referent="RBX135">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="RBX136">
      <Properties>
        <string name="Name">RodeoFantasy</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX137">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">-- Confirmed rules and adjustable prototype presentation values are kept separate.
local Config = {}

Config.Monster = {
	Id = "Emberrat",
	Name = "앰버랫",
	Design = "B",
}

-- Merging/evolution remain pending.
Config.Growth = {
	MaxStars = 10,
	CopiesPerUpgrade = 3,
	EvolutionStars = { 3, 6, 9 },
}

Config.Zoo = {
	Slots = 4,
	IncomeSeconds = 2,
	IncomeAmount = 1,
}

Config.Capture = {
	JumpMeters = 3,
	RideSeconds = 3,
	HoldSeconds = 5,
	First = { White = 0.85, Yellow = 0.14, Orange = 0.01 },
	Repeat = { White = 0.80, Yellow = 0.17, Orange = 0.03 },
}

-- These are tuning values for testing, not finalized game balance/art.
Config.Prototype = {
	MetersPerStud = 0.28,
	ForwardStudsPerSecond = 40,
	SidewaysStudsPerSecond = 22,
	JumpSeconds = 0.45,
	JumpArcStuds = 3,
	BarRoundTripSeconds = 2.4,
	RoadHalfWidth = 40,
	GroundChunkStuds = 256,
	RideHeightStuds = 4,
	RespawnSeconds = 1,
}

return Config
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX138">
        <Properties>
          <string name="Name">CaptureRules</string>
          <ProtectedString name="Source">-- Pure logic: used by both the UI and server, and executable without Roblox.
local Rules = {}

function Rules.position(elapsed, roundTripSeconds)
	local phase = (math.max(0, elapsed) / roundTripSeconds) % 1
	return 1 - math.abs(2 * phase - 1)
end

function Rules.zone(position, widths)
	if position &lt; widths.White then
		return "White"
	elseif position &lt; 1 - widths.Orange then
		return "Yellow"
	else
		return "Orange"
	end
end

function Rules.inRange(dx, dy, dz, range)
	return dx * dx + dy * dy + dz * dz &lt;= range * range
end

return Rules
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX139">
        <Properties>
          <string name="Name">ZooRules</string>
          <ProtectedString name="Source">-- Session-only economy. No persistence, evolution, offline rewards or purchases.
local ZooRules = {}

function ZooRules.new(slotCount)
	local slots = {}
	for index = 1, slotCount do slots[index] = { monster = nil, pending = 0, lastIncome = 0 } end
	return { available = 0, balance = 0, slots = slots }
end

function ZooRules.grant(session)
	session.available += 1
end

function ZooRules.place(session, index, clock, monsterId)
	if type(index) ~= "number" or index ~= math.floor(index) then return false, "InvalidSlot" end
	local slot = session.slots[index]
	if not slot then return false, "InvalidSlot" end
	if slot.monster then return false, "Occupied" end
	if session.available &lt; 1 then return false, "NoMonster" end
	session.available -= 1
	slot.monster, slot.lastIncome = monsterId, clock
	return true
end

function ZooRules.accrue(session, clock, seconds, amount)
	for _, slot in ipairs(session.slots) do
		if slot.monster then
			local ticks = math.floor(math.max(0, clock - slot.lastIncome) / seconds)
			slot.pending += ticks * amount
			slot.lastIncome += ticks * seconds
		end
	end
end

function ZooRules.collect(session, index)
	local slot = session.slots[index]
	if not slot then return 0 end
	local amount = slot.pending
	slot.pending = 0
	session.balance += amount
	return amount
end

return ZooRules
</ProtectedString>
        </Properties>
      </Item>
