      <Item class="ModuleScript" referent="RBX59">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">-- Confirmed rules and adjustable prototype presentation values are kept separate.
local Config = {}

-- Creator Store music/hoof recording plus Roblox bundled action sounds.
Config.Audio = {
 BGM="rbxassetid://1839048285",
 Hooves="rbxassetid://118636555040923",
 Jump="rbxasset://sounds/action_jump.mp3",
 Rope="rbxassetid://9120718279",
 Land="rbxasset://sounds/action_jump_land.mp3",
 Success="rbxasset://sounds/volume_slider.ogg",
 MusicVolume=0.16,
 EffectsVolume=0.35,
}

Config.Monster = {
	Id = "Lumidon",
	Name = "루미돈",
}

-- Merging/evolution remain pending.
Config.Growth = {
	MaxStars = 10,
	CopiesPerUpgrade = 3,
	EvolutionStars = { 3, 6, 9 },
}

Config.BagIncome = {
	IncomeSeconds = 2,
	IncomeAmount = 1,
}

-- Original-style behaviours; exact source-game numbers are not verified.
-- Timing below is explicit prototype tuning, not a claim of identical balance.
Config.Hunt = {
	TameSeconds = 5,
	AngerSeconds = 8,
	AngerEnabled = true,
}

-- These are tuning values for testing, not finalized game balance/art.
Config.Prototype = {
	MetersPerStud = 0.625,
	ForwardStudsPerSecond = 64,
	SidewaysStudsPerSecond = 32,
	JumpSeconds = 0.28,
	IntroSeconds = 0.55,
	JumpArcStuds = 10,
	RoadHalfWidth = 35,
	HerdStudsPerSecond = 44,
	SwitchDashSeconds = 0.6,
	SwitchDashMultiplier = 1.5,
	HerdSpawnChance = 0.325,
	RockSpawnChance = 0.825,
	AirStudsPerSecond = 80,
	LassoRangeStuds = 12,
	FlightSeconds = 1.2,
	AngerWarningSeconds = 2,
	BuckCycleSeconds = 0.55,
	BuckHeightStuds = 2.4,
	AngrySteerMultiplier = 0.35,
	BuckSidewaysStudsPerSecond = 12,
	LandingGraceSeconds = 2,
	GroundChunkStuds = 256,
	RideHeightStuds = 2,
	RideForwardStuds = -0.4,
	RespawnSeconds = 1,
	CameraHeightStuds = 56,
	CameraBehindStuds = 32,
	CameraLookAheadStuds = 16,
	CameraSideStuds = 22,
	CameraGroundFocusStuds = 2,
	CameraFieldOfView = 50,
}

return Config
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX60">
        <Properties>
          <string name="Name">HuntRules</string>
          <ProtectedString name="Source">-- Pure rules for continuous riding, airborne lassoing and swept collisions.
local Rules = {}

function Rules.rideSpeed(clock,dashUntil,base,multiplier)
 return base*(dashUntil and clock&lt;dashUntil and multiplier or 1)
end

function Rules.jumpHeight(elapsed, duration, height)
	return math.sin(math.clamp(elapsed / duration, 0, 1) * math.pi) * height
end

-- One ground-to-ground hop. Shared only for synchronized presentation and server motion.
function Rules.buck(elapsed,cycle,height)
 local phase=(math.max(elapsed,0)%cycle)/cycle
 local direction=math.floor(math.max(elapsed,0)/cycle)%2==0 and 1 or -1
 return math.sin(math.pi*phase)*height, math.sin(math.pi*phase)*direction, math.sin(math.pi*phase*2)*0.28
end

function Rules.progress(elapsed, duration)
	return math.clamp(elapsed / duration, 0, 1)
end

function Rules.inRange(dx, dz, range)
	return dx == dx and dz == dz and dx * dx + dz * dz &lt;= range * range
end

function Rules.sweptBox(ax, ay, az, bx, by, bz, cx, cy, cz, sx, sy, sz, radius)
	local enter, leave = 0, 1
	local origins, deltas = {ax, ay, az}, {bx-ax, by-ay, bz-az}
	local centers, halves = {cx, cy, cz}, {sx/2+radius, sy/2+radius, sz/2+radius}
	for axis = 1, 3 do
		local low, high = centers[axis]-halves[axis], centers[axis]+halves[axis]
		if math.abs(deltas[axis]) &lt; 0.000001 then
			if origins[axis] &lt; low or origins[axis] &gt; high then return false end
		else
			local first, last = (low-origins[axis])/deltas[axis], (high-origins[axis])/deltas[axis]
			if first &gt; last then first, last = last, first end
			enter, leave = math.max(enter, first), math.min(leave, last)
			if enter &gt; leave then return false end
		end
	end
	return true
end

return Rules
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX61">
        <Properties>
          <string name="Name">HerdMotion</string>
          <ProtectedString name="Source">-- Numeric route planning for unmounted animals; authority remains on the server.
local Motion={}

function Motion.new(x,seed)
 return {home=x,elapsed=0,phase=seed*2.399963,amplitude=2.5+seed%3*0.6,vx=0}
end

function Motion.step(state,x,z,dt,rocks,tuning,halfX,halfZ,rules,course)
 dt=math.max(0,math.min(dt,0.1))
 state.elapsed+=dt
 local limit=(course and course.width(z) or tuning.RoadHalfWidth)-halfX-1
 local speed=tuning.HerdStudsPerSecond
 local horizon=speed*1.5+halfZ
 local intervals
 for attempt=1,4 do
 intervals=course and course.planningRanges(z,horizon,halfX+1) or {{-limit,limit}}
 if course and course.median(z)&gt;0 then
  local reachable={}
  for _,range in ipairs(intervals) do
   if (x&lt;0 and range[1]&lt;0) or (x&gt;=0 and range[2]&gt;0) then table.insert(reachable,range) end
  end
  intervals=reachable
 end
 -- Select a corridor that stays clear for the animal's full footprint.
 for _,rock in ipairs(rocks) do
  local depth=rock.sz/2+halfZ+0.9
  if rock.z-depth&lt;=z and rock.z+depth&gt;=z-horizon then
   local low,high=rock.x-rock.sx/2-halfX-0.9,rock.x+rock.sx/2+halfX+0.9
   local remaining={}
   for _,range in ipairs(intervals) do
    if high&lt;range[1] or low&gt;range[2] then table.insert(remaining,range)
    else
     if low&gt;range[1] then table.insert(remaining,{range[1],low}) end
     if high&lt;range[2] then table.insert(remaining,{high,range[2]}) end
    end
   end
   intervals=remaining
  end
 end
 if #intervals&gt;0 then break end
 horizon*=0.5
 end
 local preferred=math.clamp(state.home+math.sin(state.elapsed*0.72+state.phase)*state.amplitude+math.sin(state.elapsed*1.13+state.phase*0.7)*0.65,-limit,limit)
 local target,best=x,math.huge
 for _,range in ipairs(intervals) do
  local candidate=math.clamp(preferred,range[1],range[2])
  local score=math.abs(candidate-preferred)+math.abs(candidate-x)*0.25
  if score&lt;best then target,best=candidate,score end
 end
 local wanted=math.clamp((target-x)*3,-14,14)
 state.vx+=math.clamp(wanted-state.vx,-45*dt,45*dt)
 local nextX,nextZ=math.clamp(x+state.vx*dt,-limit,limit),z-speed*dt
 local overlapping=false
 for _,rock in ipairs(rocks) do
  if rules.sweptBox(x,0,z,x,0,z,rock.x,0,rock.z,rock.sx+halfX*2,2,rock.sz+halfZ*2,0.35) then overlapping=true break end
 end
 if overlapping then nextZ=z end
 local function blocked(nx,nz)
  if course and not course.contains(nx,nz,halfX+0.35) and course.contains(x,z,halfX+0.35) then return true end
  for _,rock in ipairs(rocks) do
   local inside=rules.sweptBox(x,0,z,x,0,z,rock.x,0,rock.z,rock.sx+halfX*2,2,rock.sz+halfZ*2,0.35)
   -- A released animal or newly generated obstacle can already overlap. Allow
   -- lateral escape toward the selected clear corridor instead of freezing forever.
   local escaping=inside and nz==z and math.abs(target-nx)&lt;math.abs(target-x)
   if not escaping and rules.sweptBox(x,0,z,nx,0,nz,rock.x,0,rock.z,rock.sx+halfX*2,2,rock.sz+halfZ*2,0.35) then return true end
  end
  return false
 end
 -- A close or newly spawned rock must never be tunneled through between ticks.
 if blocked(nextX,nextZ) then
  if not blocked(nextX,z) then nextZ=z
  elseif not blocked(x,nextZ) then nextX=x state.vx=0
  else nextX,nextZ=x,z state.vx=0 end
 end
 return nextX,nextZ,(nextX-x)/math.max(dt,0.000001)
end

return Motion
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX62">
        <Properties>
          <string name="Name">CourseGeometry</string>
          <ProtectedString name="Source">-- First meadow only. Distances below are layout trial values in studs.
local Course={LengthStuds=1600,LengthMeters=1000}
local function ramp(d,a,b) return math.clamp((d-a)/(b-a),0,1) end
function Course.width(z)
 local d=math.max(0,-z)
 return 35-11*ramp(d,256,400)+11*ramp(d,600,800)
end
function Course.median(z)
 local d=math.max(0,-z)
 return 9*ramp(d,800,950)*(1-ramp(d,1200,1400))
end
function Course.ranges(z,padding)
 local edge=Course.width(z)-padding
 local middle=Course.median(z)
 if middle&gt;0 then return {{-edge,-middle-padding},{middle+padding,edge}} end
 return {{-edge,edge}}
end
function Course.planningRanges(z,horizon,padding)
 local edge=math.min(Course.width(z),Course.width(z-horizon),Course.width(z-horizon/2))-padding
 local middle=math.max(Course.median(z),Course.median(z-horizon),Course.median(z-horizon/2))
 if middle&gt;0 then return {{-edge,-middle-padding},{middle+padding,edge}} end
 return {{-edge,edge}}
end
function Course.contains(x,z,padding)
 for _,range in ipairs(Course.ranges(z,padding)) do
  if x&gt;range[1] and x&lt;range[2] then return true end
 end
 return false
end
return Course
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX63">
        <Properties>
          <string name="Name">BagRules</string>
          <ProtectedString name="Source">-- Session-only bag income. Summoning/display never affects income.
local BagRules = {}

function BagRules.new()
	return { monsters = {}, pending = 0, balance = 0 }
end

function BagRules.grant(session, monsterId, clock)
	table.insert(session.monsters, { monsterId = monsterId, stars = 1, lastIncome = clock })
end

function BagRules.accrue(session, clock, seconds, amount)
	for _, monster in ipairs(session.monsters) do
		local ticks = math.floor(math.max(0, clock - monster.lastIncome) / seconds)
		session.pending += ticks * amount
		monster.lastIncome += ticks * seconds
	end
end

-- Prepared for direct collection; the UI/action remains to be confirmed.
function BagRules.collect(session)
	local amount = session.pending
	session.pending = 0
	session.balance += amount
	return amount
end

return BagRules
</ProtectedString>
        </Properties>
      </Item>
