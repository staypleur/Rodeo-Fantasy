 ["Progress saved"]={ko="기록 저장됨",ja="記録を保存済み"},
 ["Progress loaded"]={ko="기록 불러옴",ja="記録を読み込み済み"},
 ["Session progress"]={ko="이번 접속의 기록",ja="今回の記録"},
 ["Progress temporarily unavailable"]={ko="기록 저장 연결을 기다리는 중",ja="記録の接続待ち"},
}
function L.text(source,locale)
 local lang=string.lower(string.sub(locale or "en",1,2))
 local row=L.entries[source]
 return row and row[lang] or source
end
function L.stats(count,money,locale)
 local lang=string.sub(locale or "en",1,2)
 local pattern=lang=="ko" and "가방: %d마리 · 모인 돈: %d" or lang=="ja" and "バッグ: %d匹 · 未受取コイン: %d" or "Bag: %d · Uncollected coins: %d"
 return string.format(pattern,count,money)
end
function L.income(amount,seconds,locale)
 local lang=string.sub(locale or "en",1,2)
 local pattern=lang=="ko" and "%s초마다 %s코인" or lang=="ja" and "%s秒ごとに%sコイン" or (amount==1 and "%s coin every %ss" or "%s coins every %ss")
 if lang=="ko" or lang=="ja" then return string.format(pattern,tostring(seconds),tostring(amount)) end
 return string.format(pattern,tostring(amount),tostring(seconds))
end
function L.levelLabel(level,current,required,locale)
 local lang=string.sub(locale or "en",1,2)
 local name=lang=="ko" and "레벨" or lang=="ja" and "レベル" or "Lv."
 return name.." "..level..(required==0 and " · MAX" or " · "..current.."/"..required.." XP")
end
function L.huntHint(meters,seconds,locale)
 local lang=string.sub(locale or "en",1,2)
 local pattern=lang=="ko" and "초원 %dm부터 등장. 점프 후 다시 Space로 줄을 던지고 %d초 동안 타세요." or lang=="ja" and "草原%dmから出現。ジャンプ後Spaceで投げ縄を使い、%d秒乗り続けよう。" or "Found in the meadow from %dm. Jump, press Space again to lasso, then ride for %ds."
 return string.format(pattern,meters,seconds)
end
function L.evolutionHint(stars,locale)
 local lang=string.sub(locale or "en",1,2)
 local pattern=lang=="ko" and "같은 종류·같은 별의 몬스터 3마리를 합쳐 %d성까지 성장시키세요. 합성 기능은 준비 중이에요." or lang=="ja" and "同種・同じ星の3匹を合成し%d星まで育てよう。合成機能は準備中。" or "Merge three of the same species and star until %d stars. Merging is coming soon."
 return string.format(pattern,stars)
end
return L
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX1810">
        <Properties>
          <string name="Name">BagRules</string>
          <ProtectedString name="Source">-- Session-only bag income. Summoning/display never affects income.
local BagRules = {}

function BagRules.new()
	return { monsters = {}, pending = 0, balance = 0, serial = 0, totalProduced = 0 }
end

function BagRules.grant(session, monsterId, clock, incomeSeconds, incomeAmount)
	session.serial=(session.serial or 0)+1
	table.insert(session.monsters, { id=session.serial, monsterId = monsterId, stars = 1, lastIncome = clock, incomeSeconds=incomeSeconds, incomeAmount=incomeAmount })
end

function BagRules.accrue(session, clock, seconds, amount)
 local gains={}
	for _, monster in ipairs(session.monsters) do
		local interval=monster.incomeSeconds or seconds
        local rate=monster.incomeAmount or amount
		local ticks = math.floor(math.max(0, clock - monster.lastIncome) / interval)
		session.pending += ticks * rate
        session.totalProduced = (session.totalProduced or 0) + ticks * rate
		monster.lastIncome += ticks * interval
  if ticks&gt;0 then table.insert(gains,{id=monster.id,amount=ticks*rate}) end
	end
 return gains
end

function BagRules.find(session,id)
 if type(id)~="number" or id~=id or id%1~=0 then return nil end
 for _,item in ipairs(session.monsters) do if item.id==id then return item end end
end
function BagRules.place(session,id,pen)
 if type(pen)~="number" or pen~=pen or pen%1~=0 or pen&lt;1 or pen&gt;4 then return false end
 local item=BagRules.find(session,id)
 if not item or item.assignedPen then return false end
 local count=0
 for _,other in ipairs(session.monsters) do if other.assignedPen==pen then count+=1 end end
 if count&gt;=2 then return false end
 item.assignedPen=pen return true
end
function BagRules.remove(session,id,pen)
 local item=BagRules.find(session,id)
 if not item or item.assignedPen~=pen then return false end
 item.assignedPen=nil return true
end

-- Prepared for direct collection; the UI/action remains to be confirmed.
function BagRules.collect(session)
	local amount = session.pending
	session.pending = 0
	session.balance += amount
	return amount
end

return BagRules
</ProtectedString>
        </Properties>
      </Item>
