      <Item class="ModuleScript" referent="RBX59">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">-- Confirmed rules and adjustable prototype presentation values are kept separate.
local Config = {}

Config.Monster = {
	Id = "Lumidon",
	Name = "루미돈",
}

-- Merging/evolution remain pending.
Config.Growth = {
	MaxStars = 10,
	CopiesPerUpgrade = 3,
	EvolutionStars = { 3, 6, 9 },
}

Config.BagIncome = {
	IncomeSeconds = 2,
	IncomeAmount = 1,
}

-- Original-style behaviours; exact source-game numbers are not verified.
-- Timing below is explicit prototype tuning, not a claim of identical balance.
Config.Hunt = {
	TameSeconds = 5,
	AngerSeconds = 8,
	BucksOff = true,
}

-- These are tuning values for testing, not finalized game balance/art.
Config.Prototype = {
	MetersPerStud = 0.625,
	ForwardStudsPerSecond = 64,
	SidewaysStudsPerSecond = 32,
	JumpSeconds = 0.28,
	IntroSeconds = 0.55,
	JumpArcStuds = 10,
	RoadHalfWidth = 35,
	HerdStudsPerSecond = 44,
	AirStudsPerSecond = 80,
	LassoRangeStuds = 12,
	FlightSeconds = 1.2,
	BuckWarningSeconds = 2,
	LandingGraceSeconds = 2,
	GroundChunkStuds = 256,
	RideHeightStuds = 4,
	RespawnSeconds = 1,
	CameraHeightStuds = 56,
	CameraBehindStuds = 32,
	CameraLookAheadStuds = 16,
	CameraSideStuds = 22,
	CameraGroundFocusStuds = 2,
	CameraFieldOfView = 50,
}

return Config
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX60">
        <Properties>
          <string name="Name">HuntRules</string>
          <ProtectedString name="Source">-- Pure rules for continuous riding, airborne lassoing and swept collisions.
local Rules = {}

function Rules.jumpHeight(elapsed, duration, height)
	return math.sin(math.clamp(elapsed / duration, 0, 1) * math.pi) * height
end

function Rules.progress(elapsed, duration)
	return math.clamp(elapsed / duration, 0, 1)
end

function Rules.inRange(dx, dz, range)
	return dx == dx and dz == dz and dx * dx + dz * dz &lt;= range * range
end

function Rules.sweptBox(ax, ay, az, bx, by, bz, cx, cy, cz, sx, sy, sz, radius)
	local enter, leave = 0, 1
	local origins, deltas = {ax, ay, az}, {bx-ax, by-ay, bz-az}
	local centers, halves = {cx, cy, cz}, {sx/2+radius, sy/2+radius, sz/2+radius}
	for axis = 1, 3 do
		local low, high = centers[axis]-halves[axis], centers[axis]+halves[axis]
		if math.abs(deltas[axis]) &lt; 0.000001 then
			if origins[axis] &lt; low or origins[axis] &gt; high then return false end
		else
			local first, last = (low-origins[axis])/deltas[axis], (high-origins[axis])/deltas[axis]
			if first &gt; last then first, last = last, first end
			enter, leave = math.max(enter, first), math.min(leave, last)
			if enter &gt; leave then return false end
		end
	end
	return true
end

return Rules
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX61">
        <Properties>
          <string name="Name">BagRules</string>
          <ProtectedString name="Source">-- Session-only bag income. Summoning/display never affects income.
local BagRules = {}

function BagRules.new()
	return { monsters = {}, pending = 0, balance = 0 }
end

function BagRules.grant(session, monsterId, clock)
	table.insert(session.monsters, { monsterId = monsterId, stars = 1, lastIncome = clock })
end

function BagRules.accrue(session, clock, seconds, amount)
	for _, monster in ipairs(session.monsters) do
		local ticks = math.floor(math.max(0, clock - monster.lastIncome) / seconds)
		session.pending += ticks * amount
		monster.lastIncome += ticks * seconds
	end
end

-- Prepared for direct collection; the UI/action remains to be confirmed.
function BagRules.collect(session)
	local amount = session.pending
	session.pending = 0
	session.balance += amount
	return amount
end

return BagRules
</ProtectedString>
        </Properties>
      </Item>
