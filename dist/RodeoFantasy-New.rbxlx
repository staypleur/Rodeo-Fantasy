chored">true</bool><bool name="CanTouch">false</bool><float name="Transparency">0</float><token name="Material">256</token><token name="shape">1</token><token name="TopSurface">3</token><token name="FrontSurface">3</token><token name="BackSurface">3</token><token name="LeftSurface">3</token><token name="RightSurface">3</token><token name="BottomSurface">4</token><bool name="CanCollide">false</bool></Properties></Item></Item></Item><Item class="ReplicatedStorage" referent="RBXNewProject3"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBXNewProject4"><Properties><string name="Name">RodeoFantasy</string></Properties><Item class="RemoteEvent" referent="RBXNewProject11"><Properties><string name="Name">CaptureRemote</string></Properties></Item><Item class="ModuleScript" referent="RBXNewProject2402"><Properties><string name="Name">BagRules</string><ProtectedString name="Source">-- Session-only bag income. Summoning/display never affects income.
local BagRules = {}

function BagRules.new()
 return { monsters = {}, eggs={}, breedingTeams={}, profile={}, pending = 0, balance = 0, serial = 0, totalProduced = 0 }
end

function BagRules.grant(session, monsterId, clock, incomeSeconds, incomeAmount)
	session.serial=(session.serial or 0)+1
	table.insert(session.monsters, { id=session.serial, monsterId = monsterId, stars = 1, lastIncome = clock, incomeSeconds=incomeSeconds, incomeAmount=incomeAmount,sex=BagRules.sexForRoll(math.random()) })
end
function BagRules.sexForRoll(roll) return roll&lt;.5 and "Male" or "Female" end

function BagRules.income(monster, fallback)
 return (monster.incomeAmount or fallback or 1)*2^(math.clamp(math.floor(monster.stars or 1),1,10)-1)
end

function BagRules.accrue(session, clock, seconds, amount)
 local gains={}
	for _, monster in ipairs(session.monsters) do
		local interval=monster.incomeSeconds or seconds
        local rate=BagRules.income(monster,amount)
		local ticks = math.floor(math.max(0, clock - monster.lastIncome) / interval)
		session.pending += ticks * rate
        session.totalProduced = (session.totalProduced or 0) + ticks * rate
		monster.lastIncome += ticks * interval
  if ticks&gt;0 then table.insert(gains,{id=monster.id,amount=ticks*rate}) end
	end
 return gains
end

function BagRules.find(session,id)
 if type(id)~="number" or id~=id or id%1~=0 then return nil end
 for _,item in ipairs(session.monsters) do if item.id==id then return item end end
end
function BagRules.place(session,id,pen)
 if type(pen)~="number" or pen~=pen or pen%1~=0 or pen&lt;1 or pen&gt;4 then return false end
 local item=BagRules.find(session,id)
 if not item or item.assignedPen then return false end
 local count=0
 for _,other in ipairs(session.monsters) do if other.assignedPen==pen then count+=1 end end
 if count&gt;=2 then return false end
 item.assignedPen=pen return true
end
function BagRules.remove(session,id,pen)
 local item=BagRules.find(session,id)
 if not item or item.assignedPen~=pen then return false end
 item.assignedPen=nil return true
end

-- Consumes exactly three distinct copies of the same species and star tier.
-- Returns the new monster and the affected ranches, or nil plus a reason.
function BagRules.evolve(session,ids,clock)
 if type(ids)~="table" or #ids~=3 then return nil,"NeedThree" end
 local unique,selected={},{}
 for _,id in ipairs(ids) do
  if type(id)~="number" or id~=id or id%1~=0 or unique[id] then return nil,"InvalidSelection" end
  unique[id]=true
  local item=BagRules.find(session,id)
  if not item then return nil,"MissingMonster" end
  if item.breedingTeam or item.tradeLock then return nil,"MonsterBusy" end
  table.insert(selected,item)
 end
 local first=selected[1]
 if math.floor(first.stars or 1)&gt;=10 then return nil,"MaxStars" end
 for index=2,3 do
  local item=selected[index]
  if item.monsterId~=first.monsterId then return nil,"DifferentSpecies" end
  if item.stars~=first.stars then return nil,"DifferentStars" end
 end
 local affected={}
 for _,item in ipairs(selected) do if item.assignedPen then affected[item.assignedPen]=true end end
 for index=#session.monsters,1,-1 do
  if unique[session.monsters[index].id] then table.remove(session.monsters,index) end
 end
 if session.profile then for index=#session.profile,1,-1 do if unique[session.profile[index]] then table.remove(session.profile,index) end end end
 session.serial=(session.serial or 0)+1
 local evolved={id=session.serial,monsterId=first.monsterId,stars=first.stars+1,lastIncome=clock,
  incomeSeconds=first.incomeSeconds,incomeAmount=first.incomeAmount}
 table.insert(session.monsters,evolved)
 return evolved,affected
end

-- Prepared for direct collection; the UI/action remains to be confirmed.
function BagRules.collect(session)
	local amount = session.pending
	session.pending = 0
	session.balance += amount
	return amount
end

return BagRules
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXNewProject2403"><Properties><string name="Name">CollectionQuery</string><ProtectedString name="Source">local Q={}
function Q.regions(catalog)
 local regions={"All","Breeding"} local known={All=true,Breeding=true}
 for _,id in ipairs(catalog.Order) do
  local region=catalog[id].Region or "Meadow"
  if not known[region] then known[region]=true table.insert(regions,2,region) end
 end
 return regions
end
function Q.filter(items,catalog,region,search,name)
 local result={} search=string.lower(search or "")
 for _,item in ipairs(items) do
  local species=catalog[item.monsterId]
  if species and (region=="All" or (species.Region or "Meadow")==region) then
   local text=string.lower((name and name(item.monsterId) or item.monsterId).." "..item.monsterId)
   if search=="" or string.find(text,search,1,true) then table.insert(result,item) end
  end
 end
 return result
end
function Q.entries(catalog)
 local entries={}
 for _,id in ipairs(catalog.Order) do
  for _,stars in ipairs({1,3,6,9}) do table.insert(entries,{monsterId=id,stars=stars,key=id..":"..stars}) end
 end
 return entries
end
return Q
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXNewProject2404"><Properties><string name="Name">Config</string><ProtectedString name="Source">-- Confirmed rules and adjustable prototype presentation values are kept separate.
local Config = {}
Config.LobbyWalkSpeed=40 -- Adjustable presentation tuning for the larger lobby.

-- Creator Store music/hoof recording plus Roblox bundled action sounds.
Config.Audio = {
 Wind="rbxassetid://2306939610", -- Creator Store wind; availability requires Studio verification.
 BookOpen="rbxassetid://9118835414", -- ProSoundEffects: Scrapbook Open And Turn Pages 2
 PageTurn="rbxassetid://9118835637", -- ProSoundEffects: Scrapbook Open And Turn Pages 5
 BagOpen="rbxassetid://9121003611", -- ProSoundEffects: Zipper Fly On Jeans Various Speeds 5
 LobbyBGM="rbxassetid://9044539308", -- APMOfficial Fashion Lobby, replaceable trial
 BGM="rbxassetid://1839048285",
 Hooves="rbxassetid://118636555040923",
 Jump="rbxasset://sounds/action_jump.mp3",
 Rope="rbxassetid://9120718279",
 Land="rbxasset://sounds/action_jump_land.mp3",
 Success="rbxasset://sounds/volume_slider.ogg",
 Warning="rbxasset://sounds/volume_slider.ogg",
 CrashObstacle="rbxasset://sounds/impact_explosion_03.mp3",
 CrashMonster="rbxasset://sounds/ouch.ogg",
 Fall="rbxasset://sounds/action_jump_land.mp3",
 Knock="rbxasset://sounds/action_jump_land.mp3",
 BreakWood="rbxasset://sounds/impact_explosion_03.mp3",
 BreakRock="rbxasset://sounds/impact_explosion_03.mp3",
 HoovesFallback="rbxasset://sounds/action_footsteps_plastic.mp3",
 WarningInterval=0.55,
 EventMaxAge=1.5,
 EventHearingDistance=160,
 MusicVolume=0.16,
 EffectsVolume=0.35,
}

Config.Monster = {
	Id = "MeadowMouse",
	Name = "MeadowMouse",
 RunSpeed = 64, -- species-specific riding speed
 SizeClass = "Small", -- meadow mouse
}

-- Merging/evolution remain pending.
Config.Growth = {
	MaxStars = 10,
	CopiesPerUpgrade = 3,
	EvolutionStars = { 3, 6, 9 },
}

Config.BagIncome = {
	IncomeSeconds = 3,
	IncomeAmount = 1,
}

-- Original-style behaviours; exact source-game numbers are not verified.
-- Timing below is explicit prototype tuning, not a claim of identical balance.
Config.Hunt = {
	TameSeconds = 5,
	AngerSeconds = 8,
	AngerEnabled = true,
}

-- These are tuning values for testing, not finalized game balance/art.
Config.Prototype = {
	MetersPerStud = 0.625 / 3,
	ForwardStudsPerSecond = 64,
	SidewaysStudsPerSecond = 32,
	JumpSeconds = 0.28,
	IntroSeconds = 0.55,
	JumpArcStuds = 10,
	RoadHalfWidth = 94, -- 192-stud course with a 2-stud collision margin.
	HerdStudsPerSecond = 44,
	SwitchDashSeconds = 0.6,
	SwitchDashMultiplier = 1.5,
	HerdSpawnChance = 0.325,
	RockSpawnChance = 0.825,
 CrateSpawnChance = 0.07, -- rare placement trial, not final density
	AirStudsPerSecond = 80,
	LassoRangeStuds = 12,
	FlightSeconds = 1.2,
	AngerWarningSeconds = 2,
	BuckCycleSeconds = 0.55,
	BuckHeightStuds = 2.4,
	AngrySteerMultiplier = 0.35,
	BuckSidewaysStudsPerSecond = 12,
	GroundChunkStuds = 256,
	RideHeightStuds = 2,
	RideForwardStuds = -0.4,
	RespawnSeconds = 1,
	CameraHeightStuds = 56,
	CameraBehindStuds = 32,
	CameraLookAheadStuds = 16,
	CameraSideStuds = 22,
	CameraGroundFocusStuds = 2,
	CameraFieldOfView = 50,
}

return Config
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXNewProject2405"><Properties><string name="Name">CourseGeometry</string><ProtectedString name="Source">-- Green Star keeps the full 192-stud width for its entire 1,000m.
local C={LengthStuds=4800,LayoutScale=3,LengthMeters=1000}
function C.width() return 96 end
function C.median() return 0 end
function C.ranges(z,padding) return {{-96+padding,96-padding}} end
function C.planningRanges(z,horizon,padding) return C.ranges(z,padding) end
function C.contains(x,z,padding) local r=C.ranges(z,padding)[1] return x&gt;r[1] and x&lt;r[2] end
return C
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXNewProject2406"><Properties><string name="Name">DepartureSelectionRules</string><ProtectedString name="Source">-- Server-side validation for the upcoming planet -&gt; owned mount flow.
-- Returns the owned item, never accepts client monster stats or wild models.
local Rules={}
function Rules.validate(bag,destinationId,itemId,catalog,availableModels)
 if destinationId~="GreenStar" then return nil,"UnknownDestination" end
 if type(itemId)~="number" or itemId~=itemId or itemId%1~=0 then return nil,"InvalidMonster" end
 if type(bag)~="table" or type(bag.monsters)~="table" then return nil,"InventoryUnavailable" end
 for _,item in ipairs(bag.monsters) do
  if item.id==itemId then
   if item.breedingTeam or item.tradeLock then return nil,"MonsterBusy" end
   if not catalog[item.monsterId] then return nil,"UnknownSpecies" end
   if not availableModels(item.monsterId,item.stars or 1) then return nil,"ModelPending" end
   return item
  end
 end
 return nil,"NotOwned"
end
return Rules
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXNewProject2407"><Properties><string name="Name">GreenStarLayout</string><ProtectedString name="Source">return {blocks={
