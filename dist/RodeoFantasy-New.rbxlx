</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXNewProject37"><Properties><string name="Name">HerdMotion</string><ProtectedString name="Source">-- Numeric route planning for unmounted animals; authority remains on the server.
local Motion={}

function Motion.new(x,seed)
 return {home=x,elapsed=0,phase=seed*2.399963,amplitude=2.5+seed%3*0.6,vx=0}
end

function Motion.step(state,x,z,dt,rocks,tuning,halfX,halfZ,rules,course)
 dt=math.max(0,math.min(dt,0.1))
 state.elapsed+=dt
 local limit=(course and course.width(z) or tuning.RoadHalfWidth)-halfX-1
 local speed=tuning.HerdStudsPerSecond
 local horizon=speed*1.5+halfZ
 local intervals
 for attempt=1,4 do
 intervals=course and course.planningRanges(z,horizon,halfX+1) or {{-limit,limit}}
 if course and course.median(z)&gt;0 then
  local reachable={}
  for _,range in ipairs(intervals) do
   if (x&lt;0 and range[1]&lt;0) or (x&gt;=0 and range[2]&gt;0) then table.insert(reachable,range) end
  end
  intervals=reachable
 end
 -- Select a corridor that stays clear for the animal's full footprint.
 for _,rock in ipairs(rocks) do
  local depth=rock.sz/2+halfZ+0.9
  if rock.z-depth&lt;=z and rock.z+depth&gt;=z-horizon then
   local low,high=rock.x-rock.sx/2-halfX-0.9,rock.x+rock.sx/2+halfX+0.9
   local remaining={}
   for _,range in ipairs(intervals) do
    if high&lt;range[1] or low&gt;range[2] then table.insert(remaining,range)
    else
     if low&gt;range[1] then table.insert(remaining,{range[1],low}) end
     if high&lt;range[2] then table.insert(remaining,{high,range[2]}) end
    end
   end
   intervals=remaining
  end
 end
 if #intervals&gt;0 then break end
 horizon*=0.5
 end
 local preferred=math.clamp(state.home+math.sin(state.elapsed*0.72+state.phase)*state.amplitude+math.sin(state.elapsed*1.13+state.phase*0.7)*0.65,-limit,limit)
 local target,best=x,math.huge
 for _,range in ipairs(intervals) do
  local candidate=math.clamp(preferred,range[1],range[2])
  local score=math.abs(candidate-preferred)+math.abs(candidate-x)*0.25
  if score&lt;best then target,best=candidate,score end
 end
 local wanted=math.clamp((target-x)*3,-14,14)
 state.vx+=math.clamp(wanted-state.vx,-45*dt,45*dt)
 local nextX,nextZ=math.clamp(x+state.vx*dt,-limit,limit),z-speed*dt
 local overlapping=false
 for _,rock in ipairs(rocks) do
  if rules.sweptBox(x,0,z,x,0,z,rock.x,0,rock.z,rock.sx+halfX*2,2,rock.sz+halfZ*2,0.35) then overlapping=true break end
 end
 if overlapping then nextZ=z end
 local function blocked(nx,nz)
  if course and not course.contains(nx,nz,halfX+0.35) and course.contains(x,z,halfX+0.35) then return true end
  for _,rock in ipairs(rocks) do
   local inside=rules.sweptBox(x,0,z,x,0,z,rock.x,0,rock.z,rock.sx+halfX*2,2,rock.sz+halfZ*2,0.35)
   -- A released animal or newly generated obstacle can already overlap. Allow
   -- lateral escape toward the selected clear corridor instead of freezing forever.
   local escaping=inside and nz==z and math.abs(target-nx)&lt;math.abs(target-x)
   if not escaping and rules.sweptBox(x,0,z,nx,0,nz,rock.x,0,rock.z,rock.sx+halfX*2,2,rock.sz+halfZ*2,0.35) then return true end
  end
  return false
 end
 -- A close or newly spawned rock must never be tunneled through between ticks.
 if blocked(nextX,nextZ) then
  if not blocked(nextX,z) then nextZ=z
  elseif not blocked(x,nextZ) then nextX=x state.vx=0
  else nextX,nextZ=x,z state.vx=0 end
 end
 return nextX,nextZ,(nextX-x)/math.max(dt,0.000001)
end

return Motion
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXNewProject38"><Properties><string name="Name">HerdVisibility</string><ProtectedString name="Source">-- Same road-centred camera as the client. Numeric projection is testable offline.
local View={}
function View.capacity(width) return width&lt;30 and 4 or 6 end
-- Let animals already on screen run out naturally when the road narrows.
function View.transitionLimit(candidates,z,aspect,t,target,previous,preferred)
 local count=0
 for _,candidate in ipairs(candidates) do
  if ((previous and previous[candidate.key]) or (preferred and preferred[candidate.key])) and View.visible(candidate.x,candidate.y,candidate.z-z,aspect,t,1) then count+=1 end
 end
 return math.max(target,count)
end
function View.visible(x,y,relativeZ,aspect,t,margin)
 local fx,fy,fz=-t.CameraSideStuds,-t.CameraHeightStuds,-(t.CameraBehindStuds+t.CameraLookAheadStuds)
 local length=math.sqrt(fx*fx+fy*fy+fz*fz)
 fx,fy,fz=fx/length,fy/length,fz/length
 local horizontal=math.sqrt(fx*fx+fz*fz)
 local rx,rz=-fz/horizontal,fx/horizontal
 local ux,uy,uz=-rz*fy,rz*fx-rx*fz,rx*fy
 local dx,dy,dz=x-t.CameraSideStuds,y-t.CameraGroundFocusStuds-t.CameraHeightStuds,relativeZ-t.CameraBehindStuds
 local depth=dx*fx+dy*fy+dz*fz
 if depth&lt;=0 then return false end
 local half=depth*math.tan(math.rad(t.CameraFieldOfView)/2)*(margin or .82)
 return math.abs(dx*rx+dz*rz)&lt;half*aspect and math.abs(dx*ux+dy*uy+dz*uz)&lt;half
end
-- Shared deterministic shortlist: only displayed wild animals can be caught/collided with.
function View.select(candidates,z,aspect,t,limit,previous,preferred)
 local visible={}
 local selected={} local count=0
 -- A rider has just left this already-visible animal. Keep it ahead of the
 -- ordinary shortlist until it runs out of view; still obey the herd cap.
 for _,candidate in ipairs(candidates) do
  if preferred and preferred[candidate.key] and count&lt;(limit or 6) and View.visible(candidate.x,candidate.y,candidate.z-z,aspect,t,1) then
   selected[candidate.key]=true count+=1
  end
 end
 local function entry(candidate)
  return not previous or candidate.emerging or candidate.atDen or not View.visible(candidate.x,candidate.y,candidate.z-z,aspect,t,1)
 end
 for _,candidate in ipairs(candidates) do
  if not selected[candidate.key] and previous and previous[candidate.key] and count&lt;(limit or 6) and View.visible(candidate.x,candidate.y,candidate.z-z,aspect,t,1) then
   selected[candidate.key]=true count+=1
  end
  if entry(candidate) and View.visible(candidate.x,candidate.y,candidate.z-z,aspect,t,1.15) then
   candidate.score=(candidate.z-z+15)^2+candidate.x*candidate.x*.2+(View.visible(candidate.x,candidate.y,candidate.z-z,aspect,t,1) and 0 or 1000000)
   table.insert(visible,candidate)
  end
 end
 table.sort(visible,function(a,b) if a.score==b.score then return a.serial&lt;b.serial end return a.score&lt;b.score end)
 -- Prefer ready runners, then fill the visible herd with animals leaving caves.
 for _,candidate in ipairs(visible) do
  if not selected[candidate.key] and not candidate.emerging and count&lt;3 and View.visible(candidate.x,candidate.y,candidate.z-z,aspect,t,1) then selected[candidate.key]=true count+=1 end
 end
 for _,candidate in ipairs(visible) do
  if not selected[candidate.key] and candidate.emerging and count&lt;math.min(limit or 6,6) and View.visible(candidate.x,candidate.y,candidate.z-z,aspect,t,1) then selected[candidate.key]=true count+=1 end
 end
 for _,candidate in ipairs(visible) do
  if not selected[candidate.key] and count&lt;(limit or 6) then selected[candidate.key]=true count+=1 end
 end
 -- Faster/flying herds can leave the inner window together. Fill the minimum
 -- from animals already inside the full camera, without replacing stable IDs.
 if count&lt;3 then
  for _,candidate in ipairs(candidates) do
   if not selected[candidate.key] and entry(candidate) and not candidate.emerging and count&lt;3 and View.visible(candidate.x,candidate.y,candidate.z-z,aspect,t,.98) then
    selected[candidate.key]=true count+=1
   end
  end
 end
 return selected
end
return View
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXNewProject39"><Properties><string name="Name">HuntRules</string><ProtectedString name="Source">-- Pure rules for continuous riding, airborne lassoing and swept collisions.
local Rules = {}

function Rules.rideSpeed(clock,dashUntil,base,multiplier)
 return base*(dashUntil and clock&lt;dashUntil and multiplier or 1)
end

function Rules.jumpHeight(elapsed, duration, height)
	return math.sin(math.clamp(elapsed / duration, 0, 1) * math.pi) * height
end

-- One ground-to-ground hop. Shared only for synchronized presentation and server motion.
function Rules.buck(elapsed,cycle,height,triple)
 if triple then
  local burst=cycle*2
  local t=math.max(elapsed,0)%burst
  if t&gt;=cycle*1.35 then return 0,0,0 end
  cycle=cycle*.45
  elapsed=t
 end
 local phase=(math.max(elapsed,0)%cycle)/cycle
 local direction=math.floor(math.max(elapsed,0)/cycle)%2==0 and 1 or -1
 return math.sin(math.pi*phase)*height, math.sin(math.pi*phase)*direction, math.sin(math.pi*phase*2)*0.28
end

function Rules.canKnock(size,target,dashing)
 return (size=="Large" and (target=="Small" or target=="Medium"))
  or (size=="Medium" and target=="Small" and dashing==true)
end

function Rules.canBreakObstacle(size,target,dashing)
 return size=="Large" and target=="Small" and dashing==true
end

-- Wooden loot containers are distinct from rocks/trees and need no dash.
function Rules.canBreakCrate(size)
 return size=="Medium" or size=="Large"
end

function Rules.progress(elapsed, duration)
	return math.clamp(elapsed / duration, 0, 1)
end

function Rules.inRange(dx, dz, range)
	return dx == dx and dz == dz and dx * dx + dz * dz &lt;= range * range
end

function Rules.sweptBox(ax, ay, az, bx, by, bz, cx, cy, cz, sx, sy, sz, radius)
	local enter, leave = 0, 1
	local origins, deltas = {ax, ay, az}, {bx-ax, by-ay, bz-az}
	local centers, halves = {cx, cy, cz}, {sx/2+radius, sy/2+radius, sz/2+radius}
	for axis = 1, 3 do
		local low, high = centers[axis]-halves[axis], centers[axis]+halves[axis]
		if math.abs(deltas[axis]) &lt; 0.000001 then
			if origins[axis] &lt; low or origins[axis] &gt; high then return false end
		else
			local first, last = (low-origins[axis])/deltas[axis], (high-origins[axis])/deltas[axis]
			if first &gt; last then first, last = last, first end
			enter, leave = math.max(enter, first), math.min(leave, last)
			if enter &gt; leave then return false end
		end
	end
	return true
end

return Rules
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXNewProject40"><Properties><string name="Name">LobbyIncubatorRules</string><ProtectedString name="Source">-- Retain every egg when moving from four lobby incubators to one.
local R={}
function R.migrate(bag)
 local occupied=false
 local returned=0
 for _,egg in ipairs(bag.eggs or {}) do
  if egg.assignedPen==1 and not occupied then occupied=true
  elseif egg.assignedPen~=nil then egg.assignedPen=nil returned+=1 end
 end
 return returned
end
return R
