272</token><token name="shape">1</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="FrontSurface">0</token><token name="BackSurface">0</token><token name="LeftSurface">0</token><token name="RightSurface">0</token></Properties><Item class="SurfaceGui" referent="RBXNewProject18"><Properties><string name="Name">Ranking</string><token name="Face">5</token><Vector2 name="CanvasSize"><X>780</X><Y>900</Y></Vector2></Properties><Item class="TextLabel" referent="RBXNewProject19"><Properties><string name="Name">Heading</string><string name="Text">도감 수집</string><float name="TextSize">52</float><float name="BackgroundTransparency">1</float><bool name="TextWrapped">true</bool><token name="TextYAlignment">0</token><Color3 name="TextColor3"><R>0.9</R><G>0.95</G><B>1</B></Color3><UDim2 name="Position"><XS>0</XS><XO>24</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>-48</XO><YS>0</YS><YO>120</YO></UDim2></Properties></Item><Item class="TextLabel" referent="RBXNewProject20"><Properties><string name="Name">Entries</string><string name="Text">기록을 불러오는 중입니다.</string><float name="TextSize">34</float><float name="BackgroundTransparency">1</float><bool name="TextWrapped">true</bool><token name="TextYAlignment">0</token><Color3 name="TextColor3"><R>0.9</R><G>0.95</G><B>1</B></Color3><UDim2 name="Position"><XS>0</XS><XO>24</XO><YS>0</YS><YO>140</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>-48</XO><YS>0</YS><YO>740</YO></UDim2></Properties></Item></Item></Item></Item><Item class="Script" referent="RBXNewProject87"><Properties><string name="Name">SpaceLobbyDoors</string><ProtectedString name="Source">-- Eight automatic door pairs. Inventory permissions stay in LobbyWorld.
local model=script.Parent
local Players=game:GetService("Players")
local Run=game:GetService("RunService")
local Tween=game:GetService("TweenService")
local doors={}
for slot=1,8 do
 local room=model.Plots:WaitForChild("Plot_"..slot)
 local left,right,sensor=room.DoorLeft,room.DoorRight,room.DoorSensor
 left.CanCollide=false right.CanCollide=false
 table.insert(doors,{left=left,right=right,sensor=sensor,lc=left.CFrame,rc=right.CFrame,open=false,tweens={}})
end
local elapsed=0
local connection=Run.Heartbeat:Connect(function(dt)
 elapsed+=dt if elapsed&lt;.2 then return end elapsed=0
 local roots={}
 for _,player in ipairs(Players:GetPlayers()) do
  local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
  local h=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
  if root and h and h.Health&gt;0 then table.insert(roots,root.Position) end
 end
 for _,door in ipairs(doors) do
  local near=false
  for _,pos in ipairs(roots) do if (pos-door.sensor.Position).Magnitude&lt;=(door.open and 20 or 16) then near=true break end end
  if near~=door.open then
   door.open=near
   for _,t in ipairs(door.tweens) do t:Cancel() end door.tweens={}
   for _,item in ipairs({{door.left,door.lc,-door.left.Size.X},{door.right,door.rc,door.right.Size.X}}) do
    local t=Tween:Create(item[1],TweenInfo.new(.35),{CFrame=item[2]*CFrame.new(near and item[3] or 0,0,0)})
    table.insert(door.tweens,t) t:Play()
   end
  end
 end
end)
model.Destroying:Connect(function() connection:Disconnect() for _,d in ipairs(doors) do for _,t in ipairs(d.tweens) do t:Cancel() end end end)
</ProtectedString><bool name="Disabled">false</bool></Properties></Item></Item><Item class="Folder" referent="RBXNewProject22"><Properties><string name="Name">RodeoPrototype</string></Properties><Item class="Folder" referent="RBXNewProject23"><Properties><string name="Name">Monsters</string></Properties></Item></Item><Item class="Model" referent="RBXNewProject24"><Properties><string name="Name">GreenStar</string></Properties></Item></Item><Item class="ReplicatedStorage" referent="RBXNewProject3"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBXNewProject4"><Properties><string name="Name">RodeoFantasy</string></Properties><Item class="RemoteEvent" referent="RBXNewProject11"><Properties><string name="Name">CaptureRemote</string></Properties></Item><Item class="ModuleScript" referent="RBXNewProject31"><Properties><string name="Name">BagRules</string><ProtectedString name="Source">-- Session-only bag income. Summoning/display never affects income.
local BagRules = {}

function BagRules.new()
 return { monsters = {}, eggs={}, breedingTeams={}, profile={}, pending = 0, balance = 0, serial = 0, totalProduced = 0 }
end

function BagRules.grant(session, monsterId, clock, incomeSeconds, incomeAmount)
	session.serial=(session.serial or 0)+1
	table.insert(session.monsters, { id=session.serial, monsterId = monsterId, stars = 1, lastIncome = clock, incomeSeconds=incomeSeconds, incomeAmount=incomeAmount,sex=BagRules.sexForRoll(math.random()) })
end
function BagRules.sexForRoll(roll) return roll&lt;.5 and "Male" or "Female" end

function BagRules.income(monster, fallback)
 return (monster.incomeAmount or fallback or 1)*2^(math.clamp(math.floor(monster.stars or 1),1,10)-1)
end

function BagRules.accrue(session, clock, seconds, amount)
 local gains={}
	for _, monster in ipairs(session.monsters) do
		local interval=monster.incomeSeconds or seconds
        local rate=BagRules.income(monster,amount)
		local ticks = math.floor(math.max(0, clock - monster.lastIncome) / interval)
		session.pending += ticks * rate
        session.totalProduced = (session.totalProduced or 0) + ticks * rate
		monster.lastIncome += ticks * interval
  if ticks&gt;0 then table.insert(gains,{id=monster.id,amount=ticks*rate}) end
	end
 return gains
end

function BagRules.find(session,id)
 if type(id)~="number" or id~=id or id%1~=0 then return nil end
 for _,item in ipairs(session.monsters) do if item.id==id then return item end end
end
function BagRules.place(session,id,pen)
 if type(pen)~="number" or pen~=pen or pen%1~=0 or pen&lt;1 or pen&gt;4 then return false end
 local item=BagRules.find(session,id)
 if not item or item.assignedPen then return false end
 local count=0
 for _,other in ipairs(session.monsters) do if other.assignedPen==pen then count+=1 end end
 if count&gt;=2 then return false end
 item.assignedPen=pen return true
end
function BagRules.remove(session,id,pen)
 local item=BagRules.find(session,id)
 if not item or item.assignedPen~=pen then return false end
 item.assignedPen=nil return true
end

-- Consumes exactly three distinct copies of the same species and star tier.
-- Returns the new monster and the affected ranches, or nil plus a reason.
function BagRules.evolve(session,ids,clock)
 if type(ids)~="table" or #ids~=3 then return nil,"NeedThree" end
 local unique,selected={},{}
 for _,id in ipairs(ids) do
  if type(id)~="number" or id~=id or id%1~=0 or unique[id] then return nil,"InvalidSelection" end
  unique[id]=true
  local item=BagRules.find(session,id)
  if not item then return nil,"MissingMonster" end
  if item.breedingTeam or item.tradeLock then return nil,"MonsterBusy" end
  table.insert(selected,item)
 end
 local first=selected[1]
 if math.floor(first.stars or 1)&gt;=10 then return nil,"MaxStars" end
 for index=2,3 do
  local item=selected[index]
  if item.monsterId~=first.monsterId then return nil,"DifferentSpecies" end
  if item.stars~=first.stars then return nil,"DifferentStars" end
 end
 local affected={}
 for _,item in ipairs(selected) do if item.assignedPen then affected[item.assignedPen]=true end end
 for index=#session.monsters,1,-1 do
  if unique[session.monsters[index].id] then table.remove(session.monsters,index) end
 end
 if session.profile then for index=#session.profile,1,-1 do if unique[session.profile[index]] then table.remove(session.profile,index) end end end
 session.serial=(session.serial or 0)+1
 local evolved={id=session.serial,monsterId=first.monsterId,stars=first.stars+1,lastIncome=clock,
  incomeSeconds=first.incomeSeconds,incomeAmount=first.incomeAmount}
 table.insert(session.monsters,evolved)
 return evolved,affected
end

-- Prepared for direct collection; the UI/action remains to be confirmed.
function BagRules.collect(session)
	local amount = session.pending
	session.pending = 0
	session.balance += amount
	return amount
end

return BagRules
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXNewProject32"><Properties><string name="Name">CollectionQuery</string><ProtectedString name="Source">local Q={}
function Q.regions(catalog)
 local regions={"All","Breeding"} local known={All=true,Breeding=true}
 for _,id in ipairs(catalog.Order) do
  local region=catalog[id].Region or "Meadow"
  if not known[region] then known[region]=true table.insert(regions,2,region) end
 end
 return regions
end
function Q.filter(items,catalog,region,search,name)
 local result={} search=string.lower(search or "")
 for _,item in ipairs(items) do
  local species=catalog[item.monsterId]
  if species and (region=="All" or (species.Region or "Meadow")==region) then
   local text=string.lower((name and name(item.monsterId) or item.monsterId).." "..item.monsterId)
   if search=="" or string.find(text,search,1,true) then table.insert(result,item) end
  end
 end
 return result
end
function Q.entries(catalog)
 local entries={}
 for _,id in ipairs(catalog.Order) do
  for _,stars in ipairs({1,3,6,9}) do table.insert(entries,{monsterId=id,stars=stars,key=id..":"..stars}) end
 end
 return entries
end
return Q
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXNewProject33"><Properties><string name="Name">Config</string><ProtectedString name="Source">-- Confirmed rules and adjustable prototype presentation values are kept separate.
